// # pulled/ — Per-Repo Documentation Sources
//
// Logline: One .oot file per nav route. The SPA fetches
//          /pulled/{repo}.oot and renders the body as markdown.
//
// Setup: 2-line .oot header, optional Source: line, then body.
//        parsePulledOot in src/main.js reads that shape.
//        Tags below are 2026-09-04. No JSON files remain.
//
// Beats:
//   1. openOODA.oot — governance, 11-repo table.
//   2. ooda.oot     — driver, 13 commands + 3 spawns.
//   3. std.oot      — 8 domains, 188 ANCHOR.oo counted.
//   4. opm.oot      — package manager live commands.
//   5. lsp.oot      — advertised LSP methods.
//   6. mcp.oot      — 22 tools from mcp/docs/TOOLS.oot.
//   7. oodar.oot    — Gen 1 host, tag v4.0.0.
//   8. oodac.oot    — compiler, 12 public subdirs, v0.2.2.

import "openOODA.oot";
import "ooda.oot";
import "std.oot";
import "opm.oot";
import "lsp.oot";
import "mcp.oot";
import "oodar.oot";
import "oodac.oot";
