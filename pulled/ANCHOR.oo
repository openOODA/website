// # pulled/ — Per-Repo Documentation Sources
//
// Logline: One .oot file per nav route. The SPA fetches
//          /pulled/{repo}.oot and renders the body as markdown.
//
// Setup: 2-line .oot header, then Source: openOODA/<repo>/docs/,
//        then body. Home is Source: openOODA/.github/docs/.
//        Default route is home. Nav order is substratum first.
//
// Beats:
//   1. home.oot      — marketing home from .github/docs/.
//   2. openOODA.oot  — governance.
//   3. oodar.oot     — Gen 1 host, tag v4.0.0.
//   4. oodac.oot     — compiler, 12 public subdirs, v0.2.2.
//   5. std.oot       — 8 domains, 188 ANCHOR.oo counted.
//   6. ooda.oot      — driver, 13 commands + 3 spawns.
//   7. packaging.oot — install.sh, apt, dnf, pacman, v0.1.6.
//   8. opm.oot       — package manager live commands.
//   9. catalog.oot   — public package list for opm search/add.
//  10. lsp.oot       — advertised LSP methods.
//  11. mcp.oot       — 22 tools from mcp/docs/TOOLS.oot.

import "home.oot";
import "openOODA.oot";
import "oodar.oot";
import "oodac.oot";
import "std.oot";
import "ooda.oot";
import "packaging.oot";
import "opm.oot";
import "catalog.oot";
import "lsp.oot";
import "mcp.oot";
