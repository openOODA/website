// # Fleet Board Refresh — Emit status/fleet.json From The Tick State File
//
// Logline: Read .fleet-state.txt + the .fleet-alerts spool and write the JSON the fleet health board renders, plus a tick-sig-deduped history line for sparklines.
//
// Setup: &FsReadCap reads the state file and alert spool; &FsWriteCap writes status/fleet.json + status/fleet_history.jsonl; &ProcessCap runs argv date for timestamps. Section parsing lives in fsrc.oo. Works against the soak-era file now and the live spool after cutover.
//
// Beats:
//   1. fr_now — epoch + ISO stamp via argv date.
//   2. fr_alerts — live breach names from the spool dir.
//   3. fr_summary — repos/workspaces/recon rollups + seal.
//   4. fr_json — assemble the digest; fr_hist_* — sig-deduped append + prune.
//   5. main — read, parse, write, print verdicts.

import "fsrc.oo";
import "fhist.oo";
import "std/fs/os/fs.oo";

// "<epoch>|<iso>" pair via argv date.
fn fr_now(p: &ProcessCap) -> String {
    let e: Result[String, String] = sys_exec(p, "date", "+%s");
    let i: Result[String, String] = sys_exec(p, "date", "-u", "+%Y-%m-%dT%H:%M:%SZ");
    let mut es: String = match e { Ok(v) => v, Err(_) => "0" };
    let mut is: String = match i { Ok(v) => v, Err(_) => "?" };
    let mut n: Int = bytes_len(es);
    while n > 0 && byte_at(es, n - 1) < 48 { es = qs_slice(es, 0, n - 1); n = n - 1; }
    let mut m: Int = bytes_len(is);
    while m > 0 && byte_at(is, m - 1) < 33 { is = qs_slice(is, 0, m - 1); m = m - 1; }
    return es + "|" + is;
}

// Live alert filenames from the spool dir as "<count>|<json-array>".
fn fr_alerts(fr: &FsReadCap, spool: String) -> String {
    let names: List[String] = fs_read_dir(fr, spool);
    let mut out: String = "";
    let mut c: Int = 0;
    let n: Int = list_len(names);
    let mut i: Int = 0;
    while i < n {
        let f: String = list_get(names, i) + "";
        if f != "." && f != ".." {
            if out != "" { out = out + ","; }
            out = out + "\"" + f + "\"";
            c = c + 1;
        }
        i = i + 1;
    }
    return c.to_string() + "|[" + out + "]";
}

// repos=/workspaces=/recon=/SEAL rollup lines into a summary object.
fn fr_summary(lines: List[String]) -> String {
    let mut out: String = "\"repos_total\":0";
    let sums: List[String] = fr_rows(lines, "repos=");
    if list_len(sums) > 0 {
        let l: String = list_get(sums, 0) + "";
        out = "\"repos_total\":" + qs_num(l, "repos=").to_string() + ",\"dirty\":" + qs_num(l, "dirty=").to_string()
            + ",\"clean\":" + qs_num(l, "clean=").to_string() + ",\"err\":" + qs_num(l, "err=").to_string()
            + ",\"locked\":" + qs_num(l, "locked=").to_string();
    }
    let wsl: List[String] = fr_rows(lines, "workspaces=");
    if list_len(wsl) > 0 {
        let l: String = list_get(wsl, 0) + "";
        out = out + ",\"ws_total\":" + qs_num(l, "workspaces=").to_string() + ",\"ws_active\":" + qs_num(l, "active=").to_string();
    }
    let rcl: List[String] = fr_rows(lines, "recon=");
    if list_len(rcl) > 0 {
        let l: String = list_get(rcl, 0) + "";
        out = out + ",\"recon_total\":" + qs_num(l, "recon=").to_string();
    }
    let sl: List[String] = fr_rows(lines, "SEAL ");
    if list_len(sl) > 0 {
        let l: String = list_get(sl, 0) + "";
        out = out + ",\"seal\":\"" + qs_tok(l, 1) + "\"";
    }
    return out;
}

// The fleet.json document: digest of one tick's state file + live alerts.
fn fr_json(iso: String, epoch: String, state_path: String, sig: String, alerts: String, lines: List[String]) -> String {
    return "{\n  \"generated_at\": \"" + iso + "\",\n  \"generated_epoch\": " + epoch + ",\n  \"state_file\": \"" + state_path
        + "\",\n  \"state_sig\": \"" + sig + "\",\n  \"alerts\": " + alerts + ",\n  \"summary\": {" + fr_summary(lines)
        + "},\n  \"repos\": " + fr_repos(lines) + ",\n  \"quota\": " + fr_quota(lines) + ",\n  \"workspaces\": " + fr_active(lines)
        + ",\n  \"health_forge\": " + fr_health(lines) + "\n}\n";
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, args: List[String]) -> Int {
    let state_path: String = if list_len(args) > 0 { list_get(args, 0) + "" } else { "/Projects/openOODA/.fleet-state.txt" };
    let spool: String = if list_len(args) > 1 { list_get(args, 1) + "" } else { "/Projects/openOODA/.fleet-alerts" };
    let out_json: String = if list_len(args) > 2 { list_get(args, 2) + "" } else { "status/fleet.json" };
    let out_hist: String = if list_len(args) > 3 { list_get(args, 3) + "" } else { "status/fleet_history.jsonl" };
    let rd: Result[String, String] = fs_read_file(fr, state_path);
    if rd.is_err() { println("ERR state file unreadable: " + state_path); return 1; }
    let doc: String = match rd { Ok(v) => v, Err(_) => "" };
    let sig: String = fr_sig(doc);
    let araw: String = fr_alerts(fr, spool);
    let abar: Int = str_index_of(araw, "|");
    let alert_n: Int = qs_num(araw, "");
    let alerts: String = qs_slice(araw, abar + 1, bytes_len(araw));
    let lines: List[String] = fr_lines(doc);
    let nowp: String = fr_now(p);
    let bar: Int = str_index_of(nowp, "|");
    let epoch: String = qs_slice(nowp, 0, bar);
    let iso: String = qs_slice(nowp, bar + 1, bytes_len(nowp));
    let w1: Result[Void, String] = fs_write_file(fw, out_json, fr_json(iso, epoch, state_path, sig, alerts, lines));
    if w1.is_err() { println("ERR fleet.json write"); return 1; }
    let hist: String = fr_hist_line(iso, epoch, sig, alert_n, lines);
    fr_hist_append(fr, fw, out_hist, hist, sig);
    println("OK fleet.json " + sig + " lines=" + list_len(lines).to_string() + " alerts=" + alerts);
    return 0;
}
