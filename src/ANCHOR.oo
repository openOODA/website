// # src/ — Website scripts
//
// Logline: Split SPA and dogfight. Each .js file is <= 256 lines.
//          Browser residual: GitHub Pages still serves .js.
//
// Setup: index.html loads boot.js in <head>, then defer scripts
//        in the order below. 404.html sets data-page="404" so
//        main.js does not overwrite #content.
//
// Beats:
//   1. theme/ — boot, palettes, cycle. System monospace. No Google.
//   2. route/ — parse pulled/*.oot into #content.
//   3. dogfight/ — specs, OODA, physics, weapons, rAF loop.
//   4. sky/ — starfield. Honors prefers-reduced-motion.
//   5. life.js — tab-hidden rAF gate.
//   6. main.js — boot: route, gen bar, initGlobalDogfight.

import "theme/ANCHOR.oo";
import "route/ANCHOR.oo";
import "dogfight/ANCHOR.oo";
import "sky/ANCHOR.oo";
