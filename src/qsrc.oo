// # Quota Sources — Byte-Native Probes For The Four Fleet Agents
//
// Logline: Pull real quota signals from mcode, grok, and vibe plus the byte-native text helpers the refresh driver needs.
//
// Setup: &ProcessCap runs argv python3/grok — never a shell; herdr runs in quota_refresh.oo. &FsReadCap reads the vibe log. mcode spend comes from the minimax sqlite local_runtime_token_usage table through a python3 adapter; grok sums per-session usage JSON; vibe state is the last 402 budget event in ~/.vibe/logs/vibe.log. All offsets are byte offsets — pane text carries multibyte glyphs, so char-indexed slices are never used.
//
// Beats:
//   1. qs_slice/qs_num/qs_str/qs_tok/qs_ctx — minimal extraction over JSON-ish, TSV, and pane text.
//   2. qs_mcode/qs_grok/qs_vibe — each returns a JSON object fragment or "ok":false.

import "oostd/app/agent/token/json_envelope.oo";
import "oostd/fs/os/fs.oo";

// The byte range [start, end) copied into a fresh String.
pub fn qs_slice(s: String, start: Int, stop: Int) -> String {
    let n: Int = bytes_len(s);
    let hi: Int = if stop > n { n } else { stop };
    let mut bs: List[Int] = bytes_new();
    let mut i: Int = if start < 0 { 0 } else { start };
    while i < hi {
        bs = bytes_push(bs, byte_at(s, i));
        i = i + 1;
    }
    return bytes_to_str(bs);
}

// First <digits> value after key in text; -1 when absent.
pub fn qs_num(text: String, key: String) -> Int {
    let k: Int = str_index_of(text, key);
    if k < 0 { return -1; }
    let n: Int = bytes_len(text);
    let mut i: Int = k + bytes_len(key);
    let mut v: Int = 0;
    let mut seen: Bool = false;
    while i < n {
        let b: Int = byte_at(text, i);
        if b >= 48 && b <= 57 {
            v = v * 10 + (b - 48);
            seen = true;
        }
        else {
            if seen { break; }
            if b != 32 && b != 58 && b != 34 { return -1; }
        }
        i = i + 1;
    }
    if !seen { return -1; }
    return v;
}

// Leading signed integer of text; -1 when no digits follow an optional '-'.
// Number-position JSON fields must emit through this so hostile tokens
// can never leak raw text into the document.
pub fn qs_int(text: String) -> Int {
    let n: Int = bytes_len(text);
    let mut i: Int = 0;
    let mut neg: Bool = false;
    if n > 0 && byte_at(text, 0) == 45 {
        neg = true;
        i = 1;
    }
    let mut v: Int = 0;
    let mut seen: Bool = false;
    while i < n {
        let b: Int = byte_at(text, i);
        if b < 48 || b > 57 { break; }
        v = v * 10 + (b - 48);
        seen = true;
        i = i + 1;
    }
    if !seen { return -1; }
    if neg { return 0 - v; }
    return v;
}

// Value string after a key passed WITH quotes ("key" -> "value"); "" when absent.
// Backslash-escaped quotes inside the value do not terminate the scan.
pub fn qs_str(text: String, key: String) -> String {
    let k: Int = str_index_of(text, key);
    if k < 0 { return ""; }
    let n: Int = bytes_len(text);
    let mut i: Int = k + bytes_len(key);
    while i < n && byte_at(text, i) != 34 { i = i + 1; }
    let s: Int = i + 1;
    let mut e: Int = s;
    let mut esc: Bool = false;
    while e < n {
        let b: Int = byte_at(text, e);
        if esc { esc = false; }
        else if b == 92 { esc = true; }
        else if b == 34 { break; }
        e = e + 1;
    }
    return qs_slice(text, s, e);
}

// The nth whitespace-delimited token; "" when fewer than n+1 exist.
pub fn qs_tok(text: String, want: Int) -> String {
    let n: Int = bytes_len(text);
    let mut i: Int = 0;
    let mut tok: Int = 0;
    while i < n {
        let b: Int = byte_at(text, i);
        if b != 32 && b != 10 && b != 9 {
            let s: Int = i;
            while i < n {
                let d: Int = byte_at(text, i);
                if d == 32 || d == 10 || d == 9 { break; }
                i = i + 1;
            }
            if tok == want { return qs_slice(text, s, i); }
            tok = tok + 1;
        }
        i = i + 1;
    }
    return "";
}

// mcode: aggregate local_runtime_token_usage over 5h and 24h windows.
pub fn qs_mcode(p: &ProcessCap, home: String) -> String {
    let code: String = "import sqlite3,sys,time\n"
        + "c=sqlite3.connect('file:'+sys.argv[1]+'?mode=ro',uri=True)\n"
        + "now=int(time.time()*1000)\n"
        + "for ms,t in [(18000000,'w5'),(86400000,'w24')]:\n"
        + " r=c.execute('select coalesce(sum(input_tokens),0),"
        + "coalesce(sum(output_tokens),0),coalesce(sum(cost_usd),0),"
        + "count(*),coalesce(max(ts),0) from local_runtime_token_usage "
        + "where ts>=?',(now-ms,)).fetchone()\n"
        + " print(t,r[0],r[1],r[2],r[3],r[4])";
    let db: String = home + "/.minimax/v2/sqlite/runtime-state.sqlite";
    let r: Result[String, String] = sys_exec(p, "python3", "-c", code, db);
    let out: String = match r { Ok(t) => t, Err(_) => "" };
    let nl: Int = str_index_of(out, "\n");
    if nl < 0 { return "\"ok\":false"; }
    let l1: String = qs_slice(out, 0, nl);
    let l2: String = qs_slice(out, nl + 1, bytes_len(out));
    return "\"ok\":true,\"in_5h\":" + qs_int(qs_tok(l1, 1)).to_string()
        + ",\"out_5h\":" + qs_int(qs_tok(l1, 2)).to_string()
        + ",\"cost_usd_5h\":" + qs_int(qs_tok(l1, 3)).to_string()
        + ",\"turns_5h\":" + qs_int(qs_tok(l1, 4)).to_string()
        + ",\"latest_ms_5h\":" + qs_int(qs_tok(l1, 5)).to_string()
        + ",\"in_24h\":" + qs_int(qs_tok(l2, 1)).to_string()
        + ",\"out_24h\":" + qs_int(qs_tok(l2, 2)).to_string()
        + ",\"cost_usd_24h\":" + qs_int(qs_tok(l2, 3)).to_string()
        + ",\"turns_24h\":" + qs_int(qs_tok(l2, 4)).to_string()
        + ",\"latest_ms_24h\":" + qs_int(qs_tok(l2, 5)).to_string();
}

// grok: sessions list -> per-session usage JSON -> summed tokens + cost ticks.
// env HOME= supplies the session-store root; env -C pins cwd to $HOME because
// grok sessions list is project-scoped and reports "No sessions found." when
// run from any other working directory.
pub fn qs_grok(p: &ProcessCap, home: String) -> String {
    let bin: String = home + "/.local/bin/grok";
    let r: Result[String, String] = sys_exec(p, "env", "-C", home, "HOME=" + home,
        bin, "sessions", "list");
    let mut rest: String = match r { Ok(t) => t, Err(_) => "" };
    let mut ids: List[String] = list_new();
    while bytes_len(rest) > 0 && list_len(ids) < 20 {
        let nl: Int = str_index_of(rest, "\n");
        let line: String = if nl < 0 { rest } else { qs_slice(rest, 0, nl) };
        let id: String = qs_tok(line, 0);
        if bytes_len(id) > 30 && str_index_of(id, "-") >= 0 { ids = list_push(ids, id); }
        rest = if nl < 0 { "" } else { qs_slice(rest, nl + 1, bytes_len(rest)) };
    }
    let mut i: Int = 0;
    let mut tok: Int = 0;
    let mut ticks: Int = 0;
    let mut used: Int = 0;
    let mut latest: String = "";
    while i < list_len(ids) {
        let u: Result[String, String] = sys_exec(p, "env", "-C", home, "HOME=" + home,
            bin, "usage", list_get(ids, i));
        let ut: String = match u { Ok(t) => t, Err(_) => "" };
        if bytes_len(ut) > 0 && byte_at(ut, 0) == 123 {
            used = used + 1;
            tok = tok + qs_num(ut, "totalTokens");
            ticks = ticks + qs_num(ut, "costUsdTicks");
            let at: String = qs_str(ut, "\"updatedAt\"");
            if latest == "" { latest = at; }
        }
        i = i + 1;
    }
    return "\"ok\":true,\"sessions\":" + list_len(ids).to_string()
        + ",\"with_usage\":" + used.to_string()
        + ",\"total_tokens\":" + tok.to_string()
        + ",\"cost_usd_ticks\":" + ticks.to_string()
        + ",\"latest_at\":" + json_str(latest);
}

// vibe: last 402 budget event in the log; tail position decides live state.
pub fn qs_vibe(fr: &FsReadCap, home: String) -> String {
    let rd: Result[String, String] = fs_read_file(fr, home + "/.vibe/logs/vibe.log");
    let log: String = match rd { Ok(t) => t, Err(_) => "" };
    if log == "" { return "\"ok\":false"; }
    let mut rest: String = log + "";
    let mut base: Int = 0;
    let mut count: Int = 0;
    let mut last: Int = -1;
    let mut go: Bool = true;
    while go {
        let i: Int = str_index_of(rest, "httpStatus\": 402");
        if i < 0 { go = false; }
        else {
            count = count + 1;
            last = base + i;
            base = base + i + 1;
            rest = qs_slice(rest, i + 1, bytes_len(rest));
        }
    }
    let mut ts: String = "";
    if last >= 0 {
        let mut ls: Int = last;
        while ls > 0 && byte_at(log, ls - 1) != 10 { ls = ls - 1; }
        ts = qs_slice(log, ls, ls + 19);
    }
    let state: String = if count > 0 && last > bytes_len(log) - 8000 { "EXHAUSTED" } else { "OK" };
    return "\"ok\":true,\"state\":\"" + state + "\",\"count_402\":" + count.to_string()
        + ",\"last_402_at\":" + json_str(ts);
}
