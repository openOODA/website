// # JSON Emitters — Escaped Document Assembly For fleet.json And quota.json
//
// Logline: Assemble the fleet board and quota board JSON documents from parsed fragments; every externally-derived string field passes through json_str so hostile text can never break the document.
//
// Setup: Pure string work — no capabilities. fsrc.oo supplies line parsing; qsrc.oo supplies qs_int/qs_num/qs_str/qs_slice; json_envelope.oo supplies json_str/json_escape (std reuse, rules.oot §1.22).
//
// Beats:
//   1. fr_alert_list/fr_summary/fr_json — fleet.json document and its alert/seal fragments.
//   2. qr_json/qr_hist_line/qr_pane_entry — quota.json document, day-grain history line, devin pane entry.
//   3. Number-position fields emit through qs_int/qs_num/.to_string() only — raw tokens never reach the document.

import "fsrc.oo";
import "qsrc.oo";
import "oostd/app/agent/token/json_envelope.oo";

// Alert names as a JSON array; "." and ".." never appear. Every name is
// escaped — spool filenames are filesystem-controlled text.
pub fn fr_alert_list(names: List[String]) -> String {
    let mut out: String = "";
    let n: Int = list_len(names);
    let mut i: Int = 0;
    while i < n {
        let f: String = list_get(names, i) + "";
        if f != "." && f != ".." {
            if out != "" { out = out + ","; }
            out = out + json_str(f);
        }
        i = i + 1;
    }
    return "[" + out + "]";
}

// repos=/workspaces=/recon=/SEAL rollup lines into a summary object.
pub fn fr_summary(lines: List[String]) -> String {
    let mut out: String = "\"repos_total\":0";
    let sums: List[String] = fr_rows(lines, "repos=");
    if list_len(sums) > 0 {
        let l: String = list_get(sums, 0) + "";
        out = "\"repos_total\":" + qs_num(l, "repos=").to_string() + ",\"dirty\":" + qs_num(l, "dirty=").to_string()
            + ",\"clean\":" + qs_num(l, "clean=").to_string() + ",\"err\":" + qs_num(l, "err=").to_string()
            + ",\"locked\":" + qs_num(l, "locked=").to_string();
    }
    let wsl: List[String] = fr_rows(lines, "workspaces=");
    if list_len(wsl) > 0 {
        let l: String = list_get(wsl, 0) + "";
        out = out + ",\"ws_total\":" + qs_num(l, "workspaces=").to_string()
            + ",\"ws_active\":" + qs_num(l, "active=").to_string();
    }
    let rcl: List[String] = fr_rows(lines, "recon=");
    if list_len(rcl) > 0 {
        let l: String = list_get(rcl, 0) + "";
        out = out + ",\"recon_total\":" + qs_num(l, "recon=").to_string();
    }
    let sl: List[String] = fr_rows(lines, "SEAL ");
    if list_len(sl) > 0 {
        let l: String = list_get(sl, 0) + "";
        out = out + ",\"seal\":" + json_str(qs_tok(l, 1));
    }
    return out;
}

// The fleet.json document: digest of one tick's state file + live alerts.
pub fn fr_json(iso: String, epoch: String, state_path: String, sig: String, alerts: String, lines: List[String]) -> String {
    return "{\n  \"generated_at\": " + json_str(iso) + ",\n  \"generated_epoch\": " + qs_int(epoch).to_string()
        + ",\n  \"state_file\": " + json_str(state_path)
        + ",\n  \"state_sig\": " + json_str(sig) + ",\n  \"alerts\": " + alerts + ",\n  \"summary\": {" + fr_summary(lines)
        + "},\n  \"repos\": " + fr_repos(lines) + ",\n  \"quota\": " + fr_quota(lines)
        + ",\n  \"workspaces\": " + fr_active(lines)
        + ",\n  \"health_forge\": " + fr_health(lines) + "\n}\n";
}

// One devin pane entry; the pane id is herdr-controlled text and is escaped.
pub fn qr_pane_entry(pid: String, ctx: Int) -> String {
    return "{\"pane\":" + json_str(pid) + ",\"ctx_pct\":" + ctx.to_string() + "}";
}

// Assemble the data file: four agent fragments under one timestamp.
pub fn qr_json(mcode: String, grok: String, devin: String, vibe: String, now: String) -> String {
    let bar: Int = str_index_of(now, "|");
    let ep: String = if bar < 0 { "0" } else { qs_int(qs_slice(now, 0, bar)).to_string() };
    let is: String = if bar < 0 { "" } else { qs_slice(now, bar + 1, bytes_len(now)) };
    let q: String = "\"";
    let nl: String = "\n";
    return "{" + nl
        + "  " + q + "generated_at" + q + ": " + json_str(is) + "," + nl
        + "  " + q + "generated_epoch" + q + ": " + ep + "," + nl
        + "  " + q + "agents" + q + ": {" + nl
        + "    " + q + "mcode" + q + ": {" + q + "source" + q + ": "
        + q + "minimax sqlite local_runtime_token_usage" + q + ", " + mcode + "}," + nl
        + "    " + q + "grok" + q + ": {" + q + "source" + q + ": "
        + q + "grok sessions list + grok usage" + q + ", " + grok + "}," + nl
        + "    " + q + "devin" + q + ": {" + q + "source" + q + ": "
        + q + "herdr pane footers" + q + ", " + devin + "}," + nl
        + "    " + q + "vibe" + q + ": {" + q + "source" + q + ": "
        + q + "vibe.log 402 budget events" + q + ", " + vibe + "}" + nl
        + "  }" + nl + "}" + nl;
}

// Compact one-line history entry built from the agent fragments — the
// per-day snapshot the 7-day trend view renders.
pub fn qr_hist_line(m: String, g: String, d: String, v: String, is: String) -> String {
    let vs: String = qs_str(v, "\"state\"");
    return "{\"date\":" + json_str(qs_slice(is, 0, 10)) + ",\"at\":" + json_str(qs_slice(is, 11, 19))
        + ",\"m_in\":" + qs_num(m, "in_5h").to_string()
        + ",\"m_out\":" + qs_num(m, "out_5h").to_string()
        + ",\"m_turns\":" + qs_num(m, "turns_5h").to_string()
        + ",\"g_tok\":" + qs_num(g, "total_tokens").to_string()
        + ",\"g_ticks\":" + qs_num(g, "cost_usd_ticks").to_string()
        + ",\"g_used\":" + qs_num(g, "with_usage").to_string()
        + ",\"d_rep\":" + qs_num(d, "reporting").to_string()
        + ",\"d_pan\":" + qs_num(d, "panes").to_string()
        + ",\"d_max\":" + qs_num(d, "max_ctx_pct").to_string()
        + ",\"v\":" + json_str(vs) + "}";
}
