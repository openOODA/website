// # Fleet History — Tick-Grain Append-Only Sparkline Feed
//
// Logline: Build and append sig-deduped per-tick history lines carrying per-repo severity vectors for the 24-tick sparklines.
//
// Setup: fsrc.oo supplies line parsing + severity map; &FsReadCap/&FsWriteCap read and rewrite status/fleet_history.jsonl.
//
// Beats:
//   1. fr_sig — content signature for dedupe.
//   2. fr_repo_map — {"name":sev} severity vector per repo.
//   3. fr_hist_line — one compact JSON line per tick.
//   4. fr_hist_append — same-sig replace, prune to 1008 lines (7 days at 600s).

import "fsrc.oo";
import "std/fs/os/fs.oo";

// Content signature: first 8 hex chars of the HMAC — history dedupe key.
pub fn fr_sig(doc: String) -> String {
    let h: String = crypto_hmac_sha256_internal("fleet-dash", doc);
    return qs_slice(h, 0, 8);
}

// Per-repo severity vector "name":sev — the sparkline feed.
fn fr_repo_map(lines: List[String]) -> String {
    let rl: List[String] = fr_rows(lines, "CLEAN ");
    let dl: List[String] = fr_rows(lines, "DIRTY ");
    let recs: List[String] = fr_rows(lines, "RECON ");
    let mut out: String = "";
    let mut i: Int = 0;
    while i < list_len(rl) + list_len(dl) {
        let l: String = if i < list_len(rl) { list_get(rl, i) + "" } else { list_get(dl, i - list_len(rl)) + "" };
        let name: String = fr_base(qs_tok(l, 1));
        let mut ver: String = "-";
        let mut j: Int = 0;
        while j < list_len(recs) {
            let r: String = list_get(recs, j) + "";
            if fr_base(qs_tok(r, 1)) == name { ver = qs_tok(r, 2); }
            j = j + 1;
        }
        if out != "" { out = out + ","; }
        out = out + "\"" + name + "\":" + fr_sev(qs_tok(l, 0), ver).to_string();
        i = i + 1;
    }
    return out;
}

// One history line: tick sig + headline metrics + per-repo severity vector.
pub fn fr_hist_line(iso: String, epoch: String, sig: String, alert_n: Int, lines: List[String]) -> String {
    let sums: List[String] = fr_rows(lines, "repos=");
    let dirty: Int = if list_len(sums) > 0 { qs_num(list_get(sums, 0) + "", "dirty=") } else { -1 };
    let mut bad: Int = 0;
    let recs: List[String] = fr_rows(lines, "RECON ");
    let n: Int = list_len(recs);
    let mut i: Int = 0;
    while i < n {
        let v: String = qs_tok(list_get(recs, i) + "", 2);
        if v != "SYNC" && v != "PULLED" && v != "AHEAD" { bad = bad + 1; }
        i = i + 1;
    }
    let mem: List[String] = fr_rows(lines, "HEALTH mem");
    let m: Int = if list_len(mem) > 0 { qs_num(list_get(mem, 0) + "", "use=") } else { -1 };
    let cut: List[String] = fr_rows(lines, "QUOTA ");
    let mut c: Int = 0;
    i = 0;
    while i < list_len(cut) {
        let s: String = qs_tok(list_get(cut, i) + "", 2);
        if s != "OK" && s != "UNKNOWN" { c = c + 1; }
        i = i + 1;
    }
    return "{\"at\":\"" + iso + "\",\"epoch\":" + epoch + ",\"sig\":\"" + sig + "\",\"dirty\":" + dirty.to_string()
        + ",\"recon_bad\":" + bad.to_string() + ",\"quota_bad\":" + c.to_string() + ",\"alerts\":" + alert_n.to_string()
        + ",\"mem\":" + m.to_string() + ",\"repo\":{" + fr_repo_map(lines) + "}}";
}

// Append the history line; same-sig last line replaced; prune to 1008.
pub fn fr_hist_append(fr: &FsReadCap, fw: &FsWriteCap, path: String, line: String, sig: String) {
    let old: String = match fs_read_file(fr, path) { Ok(v) => v, Err(_) => "" };
    let mut keep: List[String] = list_new();
    if old != "" { keep = fr_lines(old); }
    let n0: Int = list_len(keep);
    let mut drop_last: Bool = false;
    if n0 > 0 {
        let last: String = list_get(keep, n0 - 1) + "";
        if str_index_of(last, "\"sig\":\"" + sig) >= 0 { drop_last = true; }
    }
    let hi: Int = if drop_last { n0 - 1 } else { n0 };
    let mut lo: Int = 0;
    if hi + 1 > 1008 { lo = hi + 1 - 1008; }
    let mut doc: String = "";
    let mut i: Int = lo;
    while i < hi {
        doc = doc + list_get(keep, i) + "\n";
        i = i + 1;
    }
    doc = doc + line + "\n";
    let wr: Result[Void, String] = fs_write_file(fw, path, doc);
    if wr.is_err() { println("ERR fleet_history write"); }
}
