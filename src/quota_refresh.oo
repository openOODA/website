// # Quota Board Refresh — Emit status/quota.json From Live Agent Sources
//
// Logline: Read real quota signals from the four fleet agents and write the self-contained JSON data file the static quota dashboard renders.
//
// Setup: &ProcessCap runs argv python3/grok/herdr/date — never a shell. &FsReadCap reads the vibe log; &FsWriteCap writes quota.json. OODA_FLEET_HOME supplies the home dir (EnvCap only exposes OODA_* vars). Sources: qsrc.oo probes for mcode/grok/vibe; devin panes via herdr agent list + pane read footers.
//
// Beats:
//   1. qr_devin — every devin pane's (NN%) context proxy plus pane count.
//   2. qr_json — assemble {generated_at, generated_epoch, agents:{…}}.
//   3. qr_hist_line/qr_hist_append — day-grain append-only trend snapshots.
//   4. main — probe all four, write the file + history, print verdicts.

import "qsrc.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";

// Every devin pane's context-token proxy: herdr agent list -> pane ids
// -> pane read --source visible -> last (NNNc) footer count.
fn qr_devin(p: &ProcessCap, home: String, xdg: String) -> String {
    let bin: String = home + "/.local/bin/herdr";
    let r: Result[String, String] = sys_exec(p, "env", "HOME=" + home, "XDG_RUNTIME_DIR=" + xdg, bin, "agent", "list");
    let al: String = match r { Ok(t) => t, Err(_) => "" };
    if al == "" { return "\"ok\":false"; }
    let mut panes: List[String] = list_new();
    let mut rest: String = al;
    while list_len(panes) < 12 {
        let a: Int = str_index_of(rest, "\"agent\":\"devin\"");
        if a < 0 { break; }
        let tail: String = qs_slice(rest, a, bytes_len(rest));
        let pi: Int = str_index_of(tail, "\"pane_id\":\"");
        if pi < 0 { break; }
        let start: Int = pi + 11;
        let rel: String = qs_slice(tail, start, bytes_len(tail));
        let end: Int = str_index_of(rel, "\"");
        if end < 0 { break; }
        panes = list_push(panes, qs_slice(tail, start, start + end));
        rest = qs_slice(tail, start + end, bytes_len(tail));
    }
    let mut j: String = "";
    let mut i: Int = 0;
    let mut maxc: Int = 0;
    let mut rep: Int = 0;
    while i < list_len(panes) {
        let pid: String = list_get(panes, i);
        let pr: Result[String, String] = sys_exec(p, "env", "HOME=" + home, "XDG_RUNTIME_DIR=" + xdg, bin, "pane", "read", pid, "--source", "visible");
        let pt: String = match pr { Ok(t) => t, Err(_) => "" };
        let ctx: Int = qs_ctx(pt);
        if ctx > 0 {
            rep = rep + 1;
            if ctx > maxc { maxc = ctx; }
        }
        if i > 0 { j = j + ","; }
        j = j + "{\"pane\":\"" + pid + "\",\"ctx_pct\":" + ctx.to_string() + "}";
        i = i + 1;
    }
    return "\"ok\":true,\"panes\":" + list_len(panes).to_string() + ",\"reporting\":" + rep.to_string()
        + ",\"max_ctx_pct\":" + maxc.to_string() + ",\"detail\":[" + j + "]";
}

// Assemble the data file: four agent fragments under one timestamp.
fn qr_json(mcode: String, grok: String, devin: String, vibe: String, now: String) -> String {
    let bar: Int = str_index_of(now, "|");
    let ep: String = if bar < 0 { "0" } else { qs_slice(now, 0, bar) };
    let is: String = if bar < 0 { "" } else { qs_slice(now, bar + 1, bytes_len(now)) };
    return "{\n  \"generated_at\": \"" + is + "\",\n  \"generated_epoch\": " + ep + ",\n  \"agents\": {\n    \"mcode\": {\"source\": \"minimax sqlite local_runtime_token_usage\", " + mcode + "},\n    \"grok\": {\"source\": \"grok sessions list + grok usage\", " + grok + "},\n    \"devin\": {\"source\": \"herdr pane footers\", " + devin + "},\n    \"vibe\": {\"source\": \"vibe.log 402 budget events\", " + vibe + "}\n  }\n}\n";
}

// Wall clock as "epoch|iso" — the stamp fields the file carries.
fn qr_now(p: &ProcessCap) -> String {
    let e: Result[String, String] = sys_exec(p, "date", "+%s");
    let i: Result[String, String] = sys_exec(p, "date", "-u", "+%Y-%m-%dT%H:%M:%SZ");
    let ep: String = match e { Ok(t) => qs_tok(t, 0), Err(_) => "0" };
    let is: String = match i { Ok(t) => qs_tok(t, 0), Err(_) => "" };
    return ep + "|" + is;
}

// Compact one-line history entry built from the agent fragments — the
// per-day snapshot the 7-day trend view renders.
fn qr_hist_line(m: String, g: String, d: String, v: String, is: String) -> String {
    let vs: String = qs_str(v, "\"state\"");
    return "{\"date\":\"" + qs_slice(is, 0, 10) + "\",\"at\":\"" + qs_slice(is, 11, 19)
        + "\",\"m_in\":" + qs_num(m, "in_5h").to_string()
        + ",\"m_out\":" + qs_num(m, "out_5h").to_string()
        + ",\"m_turns\":" + qs_num(m, "turns_5h").to_string()
        + ",\"g_tok\":" + qs_num(g, "total_tokens").to_string()
        + ",\"g_ticks\":" + qs_num(g, "cost_usd_ticks").to_string()
        + ",\"g_used\":" + qs_num(g, "with_usage").to_string()
        + ",\"d_rep\":" + qs_num(d, "reporting").to_string()
        + ",\"d_pan\":" + qs_num(d, "panes").to_string()
        + ",\"d_max\":" + qs_num(d, "max_ctx_pct").to_string()
        + ",\"v\":\"" + vs + "\"}";
}

// Append the daily snapshot: drop any earlier line for the same date
// (day-grain append-only — the latest run of a day wins), write back.
fn qr_hist_append(fr: &FsReadCap, fw: &FsWriteCap, path: String, line: String, day: String) -> String {
    let rd: Result[String, String] = fs_read_file(fr, path);
    let old: String = match rd { Ok(t) => t, Err(_) => "" };
    let mut keep: String = "";
    let mut rest: String = old;
    while bytes_len(rest) > 0 {
        let nl: Int = str_index_of(rest, "\n");
        let l: String = if nl < 0 { rest } else { qs_slice(rest, 0, nl) };
        if bytes_len(l) > 0 && str_index_of(l, "\"date\":\"" + day + "\"") < 0 { keep = keep + l + "\n"; }
        rest = if nl < 0 { "" } else { qs_slice(rest, nl + 1, bytes_len(rest)) };
    }
    match fs_write_file(fw, path, keep + line + "\n") {
        Ok(_) => { return "HISTORY +" + day; },
        Err(e) => { return "HISTORY_ERR " + e; }
    }
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    let home: String = match env_get(env, "OODA_FLEET_HOME") { Ok(h) => h, Err(_) => "" };
    if home == "" { println("ERR quota_refresh OODA_FLEET_HOME unset"); return 2; }
    let xdg: String = match env_get(env, "OODA_FLEET_XDG") { Ok(x) => x, Err(_) => "" };
    let out: String = if list_len(args) > 0 { list_get(args, 0) } else { "status/quota.json" };
    let m: String = qs_mcode(p, home);
    let g: String = qs_grok(p, home);
    let d: String = qr_devin(p, home, xdg);
    let v: String = qs_vibe(fr, home);
    let n: String = qr_now(p);
    let body: String = qr_json(m, g, d, v, n);
    match fs_write_file(fw, out, body) {
        Ok(_) => { },
        Err(e) => {
            println("ERR quota_refresh " + e);
            return 1;
        }
    }
    let bar: Int = str_index_of(n, "|");
    let is: String = if bar < 0 { "" } else { qs_slice(n, bar + 1, bytes_len(n)) };
    let hp: String = if list_len(args) > 1 { list_get(args, 1) } else { "status/quota_history.jsonl" };
    println(qr_hist_append(fr, fw, hp, qr_hist_line(m, g, d, v, is), qs_slice(is, 0, 10)));
    println("QUOTA_BOARD " + out);
    return 0;
}
