// # website JSON Injection Gate — Escaped Emitters
//
// Logline: Hostile state-file, pane, filename, and timestamp text must never break out of the JSON string fields the .oo refresh drivers emit.
//
// Setup: Pure string functions over crafted inputs; qs_vibe reads the committed fixture at tests/json/fixtures/home. No writes, no network.
//
// Beats:
//   1. fsrc emitters escape repo names, recon verdicts, quota agents, workspace names, and health lines.
//   2. fhist/fleet/quota emitters escape keys, filenames, paths, timestamps, and pane ids; numeric fields coerce to integers.
//   3. qsrc helpers honor backslash escapes and refuse non-numeric tokens in number position.

import "emit_json.oo";
import "fsrc.oo";
import "fhist.oo";
import "qsrc.oo";

fn expect(cond: Bool, label: String) -> Bool {
    if cond {
        println("ok " + label);
        return true;
    }
    println("FAIL " + label);
    return false;
}

fn check_repos(p: Int) -> Int {
    let doc: String = "CLEAN /x/oo\"bad\".txt\nRECON /x/oo\"bad\".txt SYNC\n";
    let lines: List[String] = fr_lines(doc);
    let repos: String = fr_repos(lines);
    if expect(str_index_of(repos, "oo" + "\\\"" + "bad" + "\\\"" + ".txt") >= 0, "01 repo name quote escaped") { p = p + 1; }
    if expect(str_index_of(repos, "\"name\":\"oo\"bad") < 0, "02 raw quote breakout absent") { p = p + 1; }
    let rdoc: String = "CLEAN /x/oo\"bad\".txt\nRECON /x/oo\"bad\".txt \"PWN\"\n";
    let rrepos: String = fr_repos(fr_lines(rdoc));
    let pwn_l: Bool = str_index_of(rrepos, "PWN" + "\\\"") >= 0;
    let pwn_r: Bool = str_index_of(rrepos, "\\\"" + "PWN") >= 0;
    if expect(pwn_l || pwn_r, "03 recon verdict quote escaped") { p = p + 1; }
    let map: String = fr_repo_map(fr_lines(doc));
    if expect(str_index_of(map, "\\\"" + "bad" + "\\\"" + ".txt\":") >= 0, "04 repo map key quote escaped") { p = p + 1; }
    return p;
}

fn check_sections(p: Int) -> Int {
    let qdoc: String = "QUOTA ag\"ent OK used=1 rem=2\n";
    let quota: String = fr_quota(fr_lines(qdoc));
    if expect(str_index_of(quota, "ag" + "\\\"" + "ent") >= 0, "05 quota agent quote escaped") { p = p + 1; }
    let adoc: String = "ACTIVE-WS ws\"name blocked=1 working=2 idle=3 other=4\n";
    let act: String = fr_active(fr_lines(adoc));
    if expect(str_index_of(act, "ws" + "\\\"" + "name") >= 0, "06 workspace name quote escaped") { p = p + 1; }
    let hdoc: String = "HEALTH node \",\"injected\":1,\"y\":\"\n";
    let health: String = fr_health(fr_lines(hdoc));
    if expect(str_index_of(health, "\\\"" + "injected" + "\\\"") >= 0, "07 health line quote escaped") { p = p + 1; }
    if expect(str_index_of(health, "\",\"injected\":1") < 0, "08 health breakout absent") { p = p + 1; }
    let sdoc: String = "FORGE host </script><script>alert(1)</script>\n";
    let forge: String = fr_health(fr_lines(sdoc));
    if expect(str_index_of(forge, "</script>") >= 0, "09 markup stays inert string data") { p = p + 1; }
    return p;
}

fn check_hist(p: Int) -> Int {
    let lines: List[String] = list_new();
    let h: String = fr_hist_line("2026-11-07T00:00:00Z\"inj", "123\"bad", "abc12345", 0, lines);
    if expect(str_index_of(h, "Z" + "\\\"" + "inj") >= 0, "10 history iso quote escaped") { p = p + 1; }
    if expect(str_index_of(h, "\"epoch\":123,") >= 0, "11 hostile epoch coerced to int") { p = p + 1; }
    let h2: String = fr_hist_line("iso", "notanum", "s", 0, lines);
    if expect(str_index_of(h2, "\"epoch\":-1,") >= 0, "12 non-numeric epoch fails to -1") { p = p + 1; }
    return p;
}

fn check_fleet(p: Int) -> Int {
    let names: List[String] = list_push(list_push(list_new(), "ok.txt"), "a\"b,c.txt");
    let arr: String = fr_alert_list(names);
    if expect(str_index_of(arr, "a" + "\\\"" + "b,c.txt") >= 0, "13 alert filename quote escaped") { p = p + 1; }
    let dot: List[String] = list_push(list_new(), "..");
    let only: String = fr_alert_list(dot);
    if expect(only == "[]", "14 dot entries filtered") { p = p + 1; }
    let j: String = fr_json("2026-01-01T00:00:00Z\"i", "9\"x", "/tmp/a\"b", "sig", "[\"a\"]", list_new());
    if expect(str_index_of(j, "a" + "\\\"" + "b") >= 0, "15 state path quote escaped") { p = p + 1; }
    if expect(str_index_of(j, "Z" + "\\\"" + "i") >= 0, "16 fleet iso quote escaped") { p = p + 1; }
    if expect(str_index_of(j, "\"generated_epoch\": 9,") >= 0, "17 fleet epoch coerced") { p = p + 1; }
    let sdoc: String = "SEAL tok\"en extra\n";
    let sum: String = fr_summary(fr_lines(sdoc));
    if expect(str_index_of(sum, "tok" + "\\\"" + "en") >= 0, "18 seal token quote escaped") { p = p + 1; }
    // Round-trip: emit fr_json twice (idempotence), then parse the
    // document back through qs_* and require source-value equality.
    let fl: List[String] = fr_lines("repos=5 dirty=1 clean=4 err=0 locked=0\n" +
        "workspaces=9 active=2\nSEAL abc123\n");
    let fj: String = fr_json("2026-01-02T03:04:05Z", "123", "/tmp/fleet.state",
        "deadbeef", "[\"a.txt\"]", fl);
    let fj2: String = fr_json("2026-01-02T03:04:05Z", "123", "/tmp/fleet.state",
        "deadbeef", "[\"a.txt\"]", fl);
    if expect(fj == fj2, "19 fleet doc re-emit is byte-identical") { p = p + 1; }
    let frt: Bool = qs_str(fj, "\"generated_at\"") == "2026-01-02T03:04:05Z" &&
        qs_str(fj, "\"state_file\"") == "/tmp/fleet.state" &&
        qs_str(fj, "\"state_sig\"") == "deadbeef" && qs_num(fj, "generated_epoch") == 123 &&
        qs_num(fj, "repos_total") == 5 && qs_num(fj, "dirty") == 1 &&
        qs_str(fj, "\"seal\"") == "abc123";
    if expect(frt, "20 fleet doc fields round-trip to source values") { p = p + 1; }
    // Output-schema invariants: empty inputs still emit valid shapes,
    // dot-entries never reach the array, and multi-item rows emit one
    // object per repo under the required keys.
    if expect(fr_alert_list(list_new()) == "[]", "21 empty alert input emits []") { p = p + 1; }
    let dots: List[String] = list_push(list_push(list_push(list_new(), "."), ".."), "ok.txt");
    if expect(fr_alert_list(dots) == "[\"ok.txt\"]", "22 dot and dot-dot alerts filtered from array") { p = p + 1; }
    let ml: List[String] = fr_lines("CLEAN /a/aaa 1.0\nDIRTY /b/bbb 2.0\n");
    let fjm: String = fr_json("iso", "1", "/s", "sig", "[]", ml);
    let multi: Bool = str_index_of(fjm, "\"name\":\"aaa\"") >= 0 &&
        str_index_of(fjm, "\"name\":\"bbb\"") >= 0 &&
        str_index_of(fjm, "\"repos_total\"") >= 0 &&
        str_index_of(fjm, "\"health_forge\"") >= 0;
    if expect(multi, "23 multi-item rows emit named objects under required keys") { p = p + 1; }
    return p;
}

fn check_quota(p: Int) -> Int {
    let q: String = qr_json("", "", "", "", "0|2026-01-01T00:00:00Z\"inj");
    if expect(str_index_of(q, "Z" + "\\\"" + "inj") >= 0, "24 quota timestamp quote escaped") { p = p + 1; }
    let qh: String = qr_hist_line("", "", "", "", "2026-11-07T00:00:\"0Z");
    if expect(str_index_of(qh, ":" + "\\\"" + "0") >= 0, "25 history stamp quote escaped") { p = p + 1; }
    let pe: String = qr_pane_entry("pane\"inj", 42);
    if expect(str_index_of(pe, "pane" + "\\\"" + "inj") >= 0, "26 pane id quote escaped") { p = p + 1; }
    if expect(str_index_of(pe, "\"ctx_pct\":42") >= 0, "27 pane ctx stays numeric") { p = p + 1; }
    // Round-trip: qr_hist_line and qr_json fields parse back to sources.
    let hm: String = "{\"in_5h\":11,\"out_5h\":22,\"turns_5h\":33}";
    let hg: String = "{\"total_tokens\":44,\"cost_usd_ticks\":45,\"with_usage\":46}";
    let hd: String = "{\"reporting\":47,\"panes\":48,\"max_ctx_pct\":49}";
    let hv: String = "{\"state\":\"ok\"}";
    let his: String = "2026-11-07T01:02:03Z";
    let hl: String = qr_hist_line(hm, hg, hd, hv, his);
    let hl2: String = qr_hist_line(hm, hg, hd, hv, his);
    if expect(hl == hl2, "28 hist line re-emit is byte-identical") { p = p + 1; }
    let hrt: Bool = qs_num(hl, "m_in") == 11 && qs_num(hl, "m_out") == 22 &&
        qs_num(hl, "m_turns") == 33 && qs_num(hl, "g_tok") == 44 &&
        qs_num(hl, "g_ticks") == 45 && qs_num(hl, "g_used") == 46 &&
        qs_num(hl, "d_rep") == 47 && qs_num(hl, "d_pan") == 48 &&
        qs_num(hl, "d_max") == 49 && qs_str(hl, "\"date\"") == "2026-11-07" &&
        qs_str(hl, "\"at\"") == "01:02:03" && qs_str(hl, "\"v\"") == "ok";
    if expect(hrt, "29 hist line fields round-trip to source values") { p = p + 1; }
    let qj: String = qr_json(hm, hg, hd, hv, "456|" + his);
    let qrt: Bool = qs_str(qj, "\"generated_at\"") == his &&
        qs_num(qj, "generated_epoch") == 456 && qs_num(qj, "in_5h") == 11 &&
        qs_num(qj, "total_tokens") == 44 && qs_num(qj, "reporting") == 47 &&
        qs_str(qj, "\"state\"") == "ok";
    if expect(qrt, "30 quota doc fields round-trip to source values") { p = p + 1; }
    // Failure-shape input: every agent probe degrades to "ok":false yet
    // the document must still carry all required agent blocks.
    let qe: String = qr_json("\"ok\":false", "\"ok\":false", "\"ok\":false", "\"ok\":false", "0|");
    let qkeys: Bool = str_index_of(qe, "\"generated_at\"") >= 0 &&
        str_index_of(qe, "\"generated_epoch\"") >= 0 &&
        str_index_of(qe, "\"agents\"") >= 0 &&
        str_index_of(qe, "\"mcode\"") >= 0 &&
        str_index_of(qe, "\"grok\"") >= 0 &&
        str_index_of(qe, "\"devin\"") >= 0 &&
        str_index_of(qe, "\"vibe\"") >= 0;
    if expect(qkeys, "31 failure fragments still emit all required agent keys") { p = p + 1; }
    return p;
}

fn check_qsrc(p: Int, fr: &FsReadCap, proc: &ProcessCap) -> Int {
    let sv: String = qs_str("{\"k\":\"a\\\"b\"}", "\"k\"");
    if expect(sv == "a\\\"b", "32 qs_str honors backslash escape") { p = p + 1; }
    let qi_ok: Bool = qs_int("123x") == 123 && qs_int("abc") == 0 - 1 &&
        qs_int("-7") == 0 - 7 && qs_int("") == 0 - 1;
    if expect(qi_ok, "33 qs_int parses or refuses") { p = p + 1; }
    let vibe: String = qs_vibe(fr, "tests/json/fixtures/home");
    if expect(str_index_of(vibe, "\\\"") >= 0, "34 vibe timestamp quote escaped") { p = p + 1; }
    let mc: String = qs_mcode(proc, "/nonexistent-openooda-home");
    if expect(str_index_of(mc, "\"ok\":false") >= 0, "35 mcode failure stays valid JSON") { p = p + 1; }
    let qn: Bool = qs_num("{\"n\": -7}", "\"n\"") == 0 - 1 &&
        qs_num("{\"n\": \"12\"}", "\"n\"") == 12 &&
        qs_num("{\"n\": 0042}", "\"n\"") == 42;
    if expect(qn, "36 qs_num refuses sign, accepts quoted and zero-padded digits") { p = p + 1; }
    let qt: String = qs_str("{\"k\":\"abc", "\"k\"");
    if expect(qt == "abc", "37 qs_str unterminated value returns tail") { p = p + 1; }
    return p;
}

pub fn main(
    p: &ProcessCap,
    fr: &FsReadCap,
    e: &EnvCap
) -> Result[Int, String] {
    let mut n: Int = 0;
    n = check_repos(n);
    n = check_sections(n);
    n = check_hist(n);
    n = check_fleet(n);
    n = check_quota(n);
    n = check_qsrc(n, fr, p);
    if n == 37 {
        println("website json tests: 37/37 passed");
        return Ok(0);
    }
    println("website json tests: FAILED (" + to_string(n) + "/31)");
    return Ok(1);
}
