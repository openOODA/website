// # Hook Integrity And Sitemap Truth - Website 9.2
//
// Logline: Assert that every DOM hook of the site scripts resolves in the home page and that the sitemap names the live host.
//
// Setup: ProcessCap parses the site scripts with node --check; FsReadCap reads
// the pages, the sitemap, and the robots file; EnvCap names the site root.
//
// Beats:
//   1. hk_vals lifts every quoted value that follows a marker and closes with the required suffix.
//   2. hk_js binds the script hooks and the copy call sites to the home page ids.
//   3. hk_skel holds the page skeleton, and hk_sitemap binds the host, the locs, and the robots pointer.
//   4. main parses the scripts, runs the three gates, and prints the verdict line.

import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";

fn hk_read(fr: &FsReadCap, path: String) -> String {
    let r: Result[String, String] = fs_read_file(fr, path);
    if r.is_err() { return ""; }
    return r.val;
}

fn hk_fail(msg: String) -> Result[Int, String] {
    println("FAIL " + msg);
    return Err(msg);
}

// Every quoted value that follows one of the pipe-joined markers and ends at
// the term quote, and that the close suffix follows the term quote.
fn hk_vals(s: String, markers: String, term: String, close: String) -> List[String] {
    let mut out: List[String] = list_new();
    let ms: List[String] = str_split(markers, "|");
    let tlen: Int = bytes_len(term);
    let mut mi: Int = 0;
    while mi < list_len(ms) {
        let marker: String = list_get(ms, mi);
        let mlen: Int = bytes_len(marker);
        let mut rest: String = s;
        while true {
            let i: Int = index_of(rest, marker);
            if i < 0 { break; }
            let start: Int = i + mlen;
            let tail: String = byte_slice(rest, start, bytes_len(rest));
            let j: Int = index_of(tail, term);
            let v: String = if j >= 0 { byte_slice(tail, 0, j) } else { "" };
            let after: String = if j >= 0 { byte_slice(tail, j + tlen, bytes_len(tail)) } else { "" };
            let good: Bool = j >= 0 && str_len(v) > 0 && (close == "" || starts_with(after, close));
            if good { out = list_push(out, v); }
            rest = tail;
        }
        mi = mi + 1;
    }
    return out;
}

fn hk_has(ids: List[String], v: String) -> Bool {
    let mut i: Int = 0;
    while i < list_len(ids) {
        if list_get(ids, i) == v { return true; }
        i = i + 1;
    }
    return false;
}

// The script hooks and the copy call sites must name ids the home page owns.
fn hk_js(fr: &FsReadCap, root: String, home: String, js: List[String]) -> Result[Int, String] {
    let ids: List[String] = hk_vals(home, "id=\"", "\"", "");
    let mut i: Int = 0;
    while i < list_len(js) {
        let rel: String = list_get(js, i);
        let src: String = hk_read(fr, root + "/" + rel);
        let gid: List[String] = hk_vals(src, "getElementById(\"", "\"", ")");
        let cls: List[String] = hk_vals(src, "querySelector(\".|querySelectorAll(\".", "\"", ")");
        let mut k: Int = 0;
        while k < list_len(gid) {
            let v: String = list_get(gid, k);
            if !hk_has(ids, v) { return hk_fail(rel + " hooks missing id \"" + v + "\""); }
            k = k + 1;
        }
        let mut m: Int = 0;
        while m < list_len(cls) {
            let raw: String = list_get(cls, m);
            let v: String = byte_slice(raw, 1, bytes_len(raw));
            if !str_contains(home, v) { return hk_fail(rel + " hooks missing class \"" + v + "\""); }
            m = m + 1;
        }
        i = i + 1;
    }
    let cs: List[String] = hk_vals(home, "copySnippet('", "'", "");
    let mut n: Int = 0;
    while n < list_len(cs) {
        let v: String = list_get(cs, n);
        if !hk_has(ids, v) { return hk_fail("copySnippet targets missing id \"" + v + "\""); }
        n = n + 1;
    }
    return Ok(0);
}

// Both pages must carry the whole html skeleton.
fn hk_skel(fr: &FsReadCap, root: String) -> Result[Int, String] {
    let tags: List[String] = str_split("<!DOCTYPE html>|<html|</html>|<head|</head>|<body|</body>", "|");
    let pages: List[String] = str_split("index.html|404.html", "|");
    let mut p: Int = 0;
    while p < list_len(pages) {
        let page: String = list_get(pages, p);
        let h: String = hk_read(fr, root + "/" + page);
        let mut t: Int = 0;
        while t < list_len(tags) {
            let tag: String = list_get(tags, t);
            if !str_contains(h, tag) { return hk_fail(page + " missing " + tag); }
            t = t + 1;
        }
        p = p + 1;
    }
    return Ok(0);
}

// The sitemap must name the live host, resolve to real files, and match robots.
fn hk_sitemap(fr: &FsReadCap, root: String) -> Result[Int, String] {
    let mut host: String = list_get(str_split(hk_read(fr, root + "/CNAME"), "\n"), 0);
    if ends_with(host, "\r") { host = byte_slice(host, 0, bytes_len(host) - 1); }
    let xml: String = hk_read(fr, root + "/sitemap.xml");
    let locs: List[String] = hk_vals(xml, "<loc>", "<", "/loc>");
    if list_len(locs) == 0 { return hk_fail("sitemap has no locs"); }
    let prefix: String = "https://" + host + "/";
    let mut i: Int = 0;
    while i < list_len(locs) {
        let u: String = list_get(locs, i);
        if !starts_with(to_lowercase(u), prefix) { return hk_fail("sitemap host drift: " + u); }
        let p: String = byte_slice(u, bytes_len(prefix), bytes_len(u));
        let f: String = if p == "" { "index.html" } else { p };
        if !fs_path_exists(fr, root + "/" + f) { return hk_fail("sitemap target missing: " + u); }
        i = i + 1;
    }
    let robots: String = hk_read(fr, root + "/robots.txt");
    if !str_contains(robots, prefix + "sitemap.xml") { return hk_fail("robots.txt sitemap drift"); }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, e: &EnvCap) -> Result[Int, String] {
    let mut root: String = "/Projects/openOODA/website";
    let er: Result[String, String] = env_get(e, "OODA_SITE_ROOT");
    if er.is_ok() && str_len(er.val) > 0 { root = er.val; }
    let js: List[String] = str_split("js/copy.js|js/panels.js|js/rotate.js", "|");
    let mut i: Int = 0;
    while i < list_len(js) {
        let rel: String = list_get(js, i);
        let chk: Result[String, String] = sys_exec(p, "node", "--check", root + "/" + rel);
        if chk.is_err() { return hk_fail("syntax " + rel); }
        i = i + 1;
    }
    let home: String = hk_read(fr, root + "/index.html");
    let r1: Result[Int, String] = hk_js(fr, root, home, js);
    if r1.is_err() { return r1; }
    let r2: Result[Int, String] = hk_skel(fr, root);
    if r2.is_err() { return r2; }
    let r3: Result[Int, String] = hk_sitemap(fr, root);
    if r3.is_err() { return r3; }
    println("PASS website 9.2 hooks+sitemap+skeleton");
    return Ok(0);
}
