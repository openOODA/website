// # Install Shim Guard Test - Website Shim
//
// Logline: Assert that install.sh parses, keeps its no-empty-exec guards, and names the canonical master installer.
//
// Setup: ProcessCap runs sh -n and fetches the installer with curl argv;
// FsReadCap reads the shim and the home page; EnvCap names the site root.
//
// Beats:
//   1. sh_code drops the comment lines so the shell body alone carries the pipe check.
//   2. sh_pipe reports a curl that feeds a shell through a pipe.
//   3. sh_url lifts the canonical fetch URL and its branch.
//   4. main parses the shim, checks the guards, and fetches the canonical installer.

import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";

fn sh_read(fr: &FsReadCap, path: String) -> String {
    let r: Result[String, String] = fs_read_file(fr, path);
    if r.is_err() { return ""; }
    return r.val;
}

fn sh_fail(msg: String) -> Result[Int, String] {
    println("FAIL " + msg);
    return Err(msg);
}

// The shell body of the shim, with the comment lines dropped.
fn sh_code(shim: String) -> String {
    let lines: List[String] = str_split(shim, "\n");
    let mut out: String = "";
    let mut i: Int = 0;
    while i < list_len(lines) {
        let line: String = list_get(lines, i);
        let mut j: Int = 0;
        let mut keep: Bool = true;
        while j < bytes_len(line) {
            let c: String = byte_slice(line, j, j + 1);
            if c != " " && c != "\t" { keep = c != "#"; break; }
            j = j + 1;
        }
        if keep { out = out + line + "\n"; }
        i = i + 1;
    }
    return out;
}

// True when a pipe hands the curl output to a shell.
fn sh_shell(code: String, at: Int) -> Bool {
    let total: Int = bytes_len(code);
    let mut j: Int = at + 1;
    while j < total {
        let w: String = byte_slice(code, j, j + 1);
        if w != " " && w != "\t" && w != "\n" && w != "\r" { break; }
        j = j + 1;
    }
    let tail: String = byte_slice(code, j, total);
    if starts_with(tail, "bash") { return true; }
    if starts_with(tail, "sh") { return true; }
    return false;
}

// True when the shell body pipes a curl into a shell.
fn sh_pipe(code: String) -> Bool {
    let total: Int = bytes_len(code);
    let mut base: Int = 0;
    while base < total {
        let c: Int = index_of(byte_slice(code, base, total), "curl");
        if c < 0 { return false; }
        let start: Int = base + c;
        let mut at: Int = start + 4;
        while at < total {
            let ch: String = byte_slice(code, at, at + 1);
            if ch == "\n" { break; }
            if ch == "|" && sh_shell(code, at) { return true; }
            at = at + 1;
        }
        base = start + 4;
    }
    return false;
}

// The canonical installer URL of the shim, or an empty string.
fn sh_url(shim: String) -> String {
    let prefix: String = "https://raw.githubusercontent.com/openOODA/install/";
    let p: Int = index_of(shim, prefix);
    if p < 0 { return ""; }
    let start: Int = p + bytes_len(prefix);
    let mut run: String = "";
    let mut i: Int = start;
    while i < bytes_len(shim) {
        let c: String = byte_slice(shim, i, i + 1);
        if c == " " || c == "\t" || c == "\n" || c == "\r" || c == "\"" || c == "'" { break; }
        run = run + c;
        i = i + 1;
    }
    let mut at: Int = 0;
    let mut found: Int = -1;
    while true {
        let j: Int = index_of(byte_slice(run, at, bytes_len(run)), "/install.sh");
        if j < 0 { break; }
        found = at + j;
        at = found + 1;
    }
    if found <= 0 { return ""; }
    return prefix + byte_slice(run, 0, found + bytes_len("/install.sh"));
}

// The branch the canonical installer URL names.
fn sh_branch(url: String) -> String {
    let prefix: String = "https://raw.githubusercontent.com/openOODA/install/";
    if !starts_with(url, prefix) { return ""; }
    let rest: String = byte_slice(url, bytes_len(prefix), bytes_len(url));
    return byte_slice(rest, 0, bytes_len(rest) - bytes_len("/install.sh"));
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, e: &EnvCap) -> Result[Int, String] {
    let mut root: String = "/Projects/openOODA/website";
    let er: Result[String, String] = env_get(e, "OODA_SITE_ROOT");
    if er.is_ok() && str_len(er.val) > 0 { root = er.val; }
    let syn: Result[String, String] = sys_exec(p, "sh", "-n", root + "/install.sh");
    if syn.is_err() { return sh_fail("install.sh fails sh -n"); }
    let shim: String = sh_read(fr, root + "/install.sh");
    let markers: List[String] = str_split("mktemp|trap|-o |bash \"$TMP\"", "|");
    let mut mi: Int = 0;
    while mi < list_len(markers) {
        let marker: String = list_get(markers, mi);
        if !str_contains(shim, marker) { return sh_fail("install.sh lost no-empty-exec guard: " + marker); }
        mi = mi + 1;
    }
    if sh_pipe(sh_code(shim)) { return sh_fail("install.sh pipes curl into a shell"); }
    let url: String = sh_url(shim);
    if url == "" { return sh_fail("install.sh has no canonical fetch URL"); }
    let branch: String = sh_branch(url);
    if branch != "master" { return sh_fail("install.sh fetches branch " + branch + ", want master"); }
    let home: String = sh_read(fr, root + "/index.html");
    let doc: String = "openooda.org/install.sh";
    if !str_contains(home, doc) { return sh_fail("index.html does not document " + doc); }
    let tmp: String = "/tmp/oo-shim-installer.sh";
    let cr: Result[String, String] = sys_exec(p, "curl", "-s", "-L", "--max-time", "15", "-o", tmp, "-w", "%{http_code}", url);
    if cr.is_err() { return sh_fail("canonical installer URL unreachable: " + url + " (curl failed)"); }
    let code: Int = parse_int_digits(str_replace(cr.val, "\n", ""));
    if code >= 400 { return sh_fail("canonical installer URL dead: " + url + " -> " + code.to_string()); }
    let bd: Result[String, String] = fs_read_file(fr, tmp);
    if bd.is_err() { return sh_fail("canonical installer URL unreachable: " + url + " (no body)"); }
    let body: String = bd.val;
    if str_len(body) < 1000 { return sh_fail("canonical installer body suspiciously small"); }
    if !str_contains(body, "openOODA one-line installer") { return sh_fail("canonical installer body unrecognized"); }
    println("PASS website shim: syntax+guards+master fetch alive");
    return Ok(0);
}
