// # Shim Trust Test - Corrupt Download Refusal
//
// Logline: Run the website install shim against stubbed curl and bash and prove corrupt downloads never execute.
//
// Setup: ProcessCap runs the shim under a stub PATH; FsWriteCap writes the stubs under /tmp;
// FsReadCap probes the exec marker; EnvCap names the site root.
//
// Beats:
//   1. st_case writes a curl stub for one download mode and a bash stub that drops a marker.
//   2. st_run executes the shim with the stub directory first on PATH.
//   3. main proves HTTP errors, partial transfers, and empty bodies refuse, and a good body runs.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";
import "oostd/fs/process/env.oo";

fn st_expect(cond: Bool, label: String) -> Bool {
    if cond { println("ok " + label);
    return true; }
    println("FAIL " + label);
    return false;
}

fn st_curl(mode: String) -> String {
    let head: String = "#!/bin/sh\no=\"\"\nfor a in \"$@\"; do if [ \"$prev\" = \"-o\" ]; then o=\"$a\"; fi; "
        + "prev=\"$a\"; done\n";
    if mode == "http" { return head + "exit 22\n"; }
    if mode == "partial" { return head + "printf 'echo half' > \"$o\"\nexit 18\n"; }
    if mode == "empty" { return head + ": > \"$o\"\nexit 0\n"; }
    return head + "printf 'echo ok' > \"$o\"\nexit 0\n";
}

fn st_case(p: &ProcessCap, fw: &FsWriteCap, mode: String) -> String {
    let dir: String = "/tmp/oo-shim-trust/" + mode;
    let mk: Result[Void, String] = fs_mkdir_p(fw, dir);
    if mk.is_err() { return ""; }
    let w1: Result[Void, String] = fs_write_file(fw, dir + "/curl", st_curl(mode));
    let w2: Result[Void, String] = fs_write_file(fw, dir + "/bash", "#!/bin/sh\necho ran > " + dir + "/marker\n");
    if w1.is_err() || w2.is_err() { return ""; }
    let c1: Result[String, String] = sys_exec(p, "chmod", "755", dir + "/curl", dir + "/bash");
    let c2: Result[String, String] = sys_exec(p, "rm", "-f", dir + "/marker");
    if c1.is_err() || c2.is_err() { return ""; }
    return dir;
}

fn st_run(p: &ProcessCap, dir: String, shim: String) -> Bool {
    let r: Result[String, String] = sys_exec(p, "env", "PATH=" + dir + ":/usr/bin:/bin", "sh", shim);
    return r.is_ok();
}

fn st_refused(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, mode: String, shim: String) -> Bool {
    let dir: String = st_case(p, fw, mode);
    if dir == "" { return false; }
    let ok: Bool = st_run(p, dir, shim);
    return !ok && !path_exists(fr, dir + "/marker");
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, e: &EnvCap) -> Result[Int, String] {
    let mut root: String = "/Projects/openOODA/website";
    let er: Result[String, String] = env_get(e, "OODA_SITE_ROOT");
    if er.is_ok() && str_len(er.val) > 0 { root = er.val; }
    let shim: String = root + "/install.sh";
    let mut n: Int = 0;
    if st_expect(st_refused(p, fr, fw, "http", shim), "01 HTTP error download never executes") { n = n + 1; }
    if st_expect(st_refused(p, fr, fw, "partial", shim), "02 partial transfer never executes the truncated body") { n = n + 1; }
    if st_expect(st_refused(p, fr, fw, "empty", shim), "03 empty installer body is refused before exec") { n = n + 1; }
    let gd: String = st_case(p, fw, "good");
    let good: Bool = gd != "" && st_run(p, gd, shim) && path_exists(fr, gd + "/marker");
    if st_expect(good, "04 a complete download reaches the installer exec") { n = n + 1; }
    if n == 4 {
        println("shim trust tests: 4/4 passed");
        return Ok(0);
    }
    println("shim trust tests: FAILED (" + n.to_string() + "/4)");
    return Err("shim trust");
}
