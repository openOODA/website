// # Static Home Clipboard And Stealth Test - Website 9.1
//
// Logline: Assert that the home page keeps its clipboard copy path and names the stealth mode.
//
// Setup: FsReadCap reads the home page and the copy script from the site root;
// EnvCap names the site root; ProcessCap is bound so every page of the suite
// shares one main shape.
//
// Beats:
//   1. cp_read returns the file text, or an empty body when the file is unreadable.
//   2. cp_spa reports a home script that pulls from the retired app tree.
//   3. main runs every assertion and prints the verdict line.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";
import "oostd/fs/process/env.oo";

fn cp_read(fr: &FsReadCap, path: String) -> String {
    let r: Result[String, String] = fs_read_file(fr, path);
    if r.is_err() { return ""; }
    return r.val;
}

fn cp_fail(msg: String) -> Result[Int, String] {
    println("FAIL " + msg);
    return Err(msg);
}

// The quoted value of one attribute, up to the next quote of either kind.
fn cp_val(s: String, from: Int) -> String {
    let mut out: String = "";
    let mut i: Int = from;
    while i < bytes_len(s) {
        let c: String = byte_slice(s, i, i + 1);
        if c == "\"" || c == "'" { break; }
        out = out + c;
        i = i + 1;
    }
    return out;
}

// True when any script tag of the page loads a source from the app tree.
fn cp_spa(html: String) -> Bool {
    let mut rest: String = html;
    while true {
        let i: Int = index_of(rest, "<script");
        if i < 0 { return false; }
        let tail: String = byte_slice(rest, i, bytes_len(rest));
        let gt: Int = index_of(tail, ">");
        let tag: String = if gt < 0 { tail } else { byte_slice(tail, 0, gt) };
        let mut tr: String = tag;
        while true {
            let si: Int = index_of(tr, "src=");
            if si < 0 { break; }
            let q: Int = si + 4;
            if q >= bytes_len(tr) { break; }
            let qc: String = byte_slice(tr, q, q + 1);
            if qc == "\"" || qc == "'" {
                if str_contains(cp_val(tr, q + 1), "/src/") { return true; }
            }
            tr = byte_slice(tr, q, bytes_len(tr));
        }
        rest = byte_slice(rest, i + 1, bytes_len(rest));
    }
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, e: &EnvCap) -> Result[Int, String] {
    let mut root: String = "/Projects/openOODA/website";
    let er: Result[String, String] = env_get(e, "OODA_SITE_ROOT");
    if er.is_ok() && str_len(er.val) > 0 { root = er.val; }
    let home: String = cp_read(fr, root + "/index.html");
    let copy: String = cp_read(fr, root + "/js/copy.js");
    if !str_contains(copy, "clipboard") { return cp_fail("no clipboard"); }
    if !str_contains(copy, "fallbackCopy") && !str_contains(copy, "execCommand") { return cp_fail("no fallback"); }
    if !str_contains(copy, "COPIED") { return cp_fail("no copied"); }
    if !str_contains(home, "https://github.com/openOODA") { return cp_fail("no openOODA href"); }
    if !str_contains(home, "Stealth Mode") { return cp_fail("stealth mode not named"); }
    if cp_spa(home) { return cp_fail("spa script on home"); }
    println("PASS website 9.1 static-home clipboard+stealth-mode");
    return Ok(0);
}
