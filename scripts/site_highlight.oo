// # SSG Code Syntax Highlighter
//
// Logline: Syntax token highlighter for openOODA code fences emitting span classes.
//
// Setup: Pure string transformation module. Imported by site_markdown.oo.
//
// Beats:
//   1. Escape raw HTML entities in code blocks.
//   2. Classify language modes (skip plain text and ascii fences).
//   3. Tokenize comments, strings, capability tokens, keywords, types, numbers, and functions.
//   4. Emit styled HTML span tags (tok-com, tok-str, tok-cap, tok-kw, tok-ty, tok-num, tok-fn).

import "std/core/str.oo";

pub fn is_id_start(c: String) -> Bool {
    let o: Int = ord(c);
    return (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || o == 95;
}

pub fn is_id_part(c: String) -> Bool {
    let o: Int = ord(c);
    return is_id_start(c) || (o >= 48 && o <= 57) || o == 33;
}

pub fn is_digit_c(c: String) -> Bool {
    let o: Int = ord(c);
    return o >= 48 && o <= 57;
}

pub fn is_kw(w: String) -> Bool {
    if w == "pub" || w == "fn" || w == "let" || w == "mut" { return true; }
    if w == "type" || w == "struct" || w == "import" || w == "return" { return true; }
    if w == "if" || w == "else" || w == "while" || w == "for" || w == "in" { return true; }
    if w == "match" || w == "requires" || w == "ensures" || w == "spec" { return true; }
    if w == "true" || w == "false" || w == "Ok" || w == "Err" || w == "void" { return true; }
    if w == "const" || w == "typedef" || w == "define" || w == "target" { return true; }
    if w == "triple" || w == "declare" || w == "assert_eq!" { return true; }
    return false;
}

pub fn is_type_name(w: String) -> Bool {
    if w == "Int" || w == "Float" || w == "Bool" || w == "String" { return true; }
    if w == "List" || w == "Option" || w == "Result" || w == "Void" { return true; }
    if w == "Char" || w == "Byte" || w == "i32" || w == "i64" || w == "i1" { return true; }
    if w == "u8" || w == "ptr" || w == "int32_t" || w == "int64_t" { return true; }
    if w == "bool" || w == "size_t" || w == "uint8_t" || w == "uint64_t" { return true; }
    return false;
}

pub fn escape_html_entities(s: String) -> String {
    let mut out: String = "";
    let n: Int = str_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "&" { out = out + "&amp;"; }
        else if c == "<" { out = out + "&lt;"; }
        else if c == ">" { out = out + "&gt;"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

pub fn highlight_code(raw: String, lang: String) -> String {
    if lang == "text" || lang == "ascii" || lang == "plain" || lang == "" {
        return escape_html_entities(raw);
    }
    let mut out: String = "";
    let n: Int = str_len(raw);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(raw, i);
        let next_c: String = if i + 1 < n { char_at(raw, i + 1) } else { "" };
        if (c == "/" && next_c == "/") || (c == "#" && (i == 0 || char_at(raw, i - 1) == "\n" || char_at(raw, i - 1) == " ")) {
            let mut com: String = "";
            while i < n && char_at(raw, i) != "\n" {
                com = com + char_at(raw, i);
                i = i + 1;
            }
            out = out + "<span class=\"tok-com\">" + escape_html_entities(com) + "</span>";
        } else if c == "\"" {
            let mut lit: String = "\"";
            i = i + 1;
            while i < n {
                let ch: String = char_at(raw, i);
                lit = lit + ch;
                if ch == "\\" && i + 1 < n {
                    i = i + 1;
                    lit = lit + char_at(raw, i);
                } else if ch == "\"" {
                    i = i + 1;
                    break;
                }
                i = i + 1;
            }
            out = out + "<span class=\"tok-str\">" + escape_html_entities(lit) + "</span>";
        } else if c == "&" && is_id_start(next_c) {
            let mut cap_name: String = "&amp;";
            i = i + 1;
            while i < n && is_id_part(char_at(raw, i)) {
                cap_name = cap_name + char_at(raw, i);
                i = i + 1;
            }
            out = out + "<span class=\"tok-cap\">" + cap_name + "</span>";
        } else if is_id_start(c) {
            let mut word: String = "";
            while i < n && is_id_part(char_at(raw, i)) {
                word = word + char_at(raw, i);
                i = i + 1;
            }
            if is_kw(word) {
                out = out + "<span class=\"tok-kw\">" + word + "</span>";
            } else if is_type_name(word) {
                out = out + "<span class=\"tok-ty\">" + word + "</span>";
            } else {
                let mut j: Int = i;
                while j < n && (char_at(raw, j) == " " || char_at(raw, j) == "\t") {
                    j = j + 1;
                }
                if j < n && char_at(raw, j) == "(" {
                    out = out + "<span class=\"tok-fn\">" + word + "</span>";
                } else {
                    out = out + word;
                }
            }
        } else if is_digit_c(c) {
            let mut num: String = "";
            while i < n && (is_digit_c(char_at(raw, i)) || char_at(raw, i) == "." || is_id_start(char_at(raw, i))) {
                num = num + char_at(raw, i);
                i = i + 1;
            }
            out = out + "<span class=\"tok-num\">" + num + "</span>";
        } else if c == "<" {
            out = out + "&lt;";
            i = i + 1;
        } else if c == ">" {
            out = out + "&gt;";
            i = i + 1;
        } else if c == "&" {
            out = out + "&amp;";
            i = i + 1;
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}
