// # SSG Base HTML Shell Template Generator
//
// Logline: Shell template loader, route body synthesizer, and HTML placeholder injector.
//
// Setup: FsReadCap required to load template fragments and source documents. Imported by site_build.oo.
//
// Beats:
//   1. Load base HTML5 shell template and fragment files from templates/ directory.
//   2. Dispatch route body compilation by source type (home_html, registry_html, play_html, wasm_html, oot).
//   3. Prepend canonical URL paragraph on .oot markdown guide documentation bodies.
//   4. Inject page title, SEO descriptions, OpenGraph tags, JSON-LD, and page body into shell.

import "std/core/str.oo";
import "site_routes.oo";
import "site_markdown.oo";
import "site_minify.oo";

pub fn load_file_content(fs: &FsReadCap, path: String) -> Result[String, String] {
    let r: Result[String, String] = read_file(fs, path);
    return r;
}

pub fn render_shell(
    shell_tmpl: String,
    title: String,
    desc: String,
    og_title: String,
    og_type: String,
    canonical: String,
    json_ld: String,
    body: String
) -> String {
    let mut page: String = shell_tmpl;
    page = ssg_str_replace(page, "__PAGE_TITLE__", title);
    page = ssg_str_replace(page, "__PAGE_DESCRIPTION__", desc);
    page = ssg_str_replace(page, "__PAGE_OG_TITLE__", og_title);
    page = ssg_str_replace(page, "__PAGE_OG_TYPE__", og_type);
    page = ssg_str_replace(page, "__PAGE_CANONICAL__", canonical);
    page = ssg_str_replace(page, "__PAGE_JSON_LD__", json_ld);
    page = ssg_str_replace(page, "__PAGE_BODY__", body);
    return page;
}

pub fn get_route_body(fs: &FsReadCap, root: String, cfg: RouteConfig) -> Result[String, String] {
    let st: String = route_source_type(cfg);
    let sf: String = route_source_file(cfg);
    let canon: String = route_canonical(cfg);
    if str_eq(st, "home_html") {
        return load_file_content(fs, root + "/templates/home.html");
    }
    if str_eq(st, "registry_html") {
        return load_file_content(fs, root + "/templates/registry.html");
    }
    if str_eq(st, "play_html") {
        return load_file_content(fs, root + "/templates/play.html");
    }
    if str_eq(st, "wasm_html") {
        return load_file_content(fs, root + "/templates/wasm.html");
    }
    if str_eq(st, "search_html") {
        return load_file_content(fs, root + "/templates/search.html");
    }
    if str_eq(st, "oot") {
        let md_res: Result[String, String] = load_file_content(fs, root + "/" + sf);
        match md_res {
            Ok(md_text) => {
                let rendered: String = compile_markdown_to_html(md_text);
                let canon_tag: String = "<p class=\"canon\">" + canon + "</p>\n";
                return Ok(canon_tag + rendered);
            },
            Err(e) => {
                return Err("Failed reading source .oot: " + sf + " (" + e + ")");
            }
        }
    }
    return Err("Unknown source type: " + st);
}
