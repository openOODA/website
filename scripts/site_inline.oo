// # SSG Inline Markdown Formatter
//
// Logline: Inline markdown parser for code spans, document links, bold, and italic formatting.
//
// Setup: Pure string transformation module. Imported by site_markdown.oo.
//
// Beats:
//   1. Protect backticked inline code spans into indexed placeholders.
//   2. Escape raw HTML entities outside code spans (&, <, >).
//   3. Resolve [text](link) anchors, mapping .oot filenames to sovereign #<route> hashes.
//   4. Convert **bold**, __bold__, *italic*, and _italic_ markdown markup to HTML tags.
//   5. Restore protected code spans wrapped in <code>...</code>.

import "std/core/str.oo";
import "site_routes.oo";

pub fn inline_str_replace(s: String, old: String, new_s: String) -> String {
    let old_len: Int = bytes_len(old);
    if old_len == 0 {
        return s;
    }
    let mut out: String = "";
    let mut current: String = s;
    while true {
        let idx: Int = str_index_of(current, old);
        if idx < 0 {
            out = out + current;
            break;
        }
        out = out + byte_slice(current, 0, idx) + new_s;
        let cur_len: Int = bytes_len(current);
        current = byte_slice(current, idx + old_len, cur_len);
    }
    return out;
}

pub fn escape_inline_html(s: String) -> String {
    let mut out: String = inline_str_replace(s, "&", "&amp;");
    out = inline_str_replace(out, "<", "&lt;");
    out = inline_str_replace(out, ">", "&gt;");
    return out;
}

fn resolve_link_href(target: String) -> String {
    if str_contains(target, "://") || str_starts_with(target, "mailto:") {
        return target;
    }
    let mut clean: String = target;
    if str_starts_with(clean, "#/") {
        clean = byte_slice(clean, 2, bytes_len(clean));
    } else if str_starts_with(clean, "/") || str_starts_with(clean, "#") {
        clean = byte_slice(clean, 1, bytes_len(clean));
    }
    let r1: String = doc_to_route(clean);
    if str_len(r1) > 0 {
        return "#" + r1;
    }
    let mut base: String = target;
    let mut idx: Int = str_len(target) - 1;
    while idx >= 0 {
        if char_at(target, idx) == "/" {
            base = byte_slice(target, idx + 1, bytes_len(target));
            break;
        }
        idx = idx - 1;
    }
    let r2: String = doc_to_route(base);
    if str_len(r2) > 0 {
        return "#" + r2;
    }
    if str_starts_with(target, "#") {
        return target;
    }
    return target;
}

fn replace_links(s: String) -> String {
    let mut out: String = "";
    let mut cur: String = s;
    while true {
        let open_b: Int = str_index_of(cur, "[");
        if open_b < 0 {
            out = out + cur;
            break;
        }
        let clen: Int = bytes_len(cur);
        let after_b: String = byte_slice(cur, open_b + 1, clen);
        let close_b: Int = str_index_of(after_b, "](");
        if close_b < 0 {
            out = out + byte_slice(cur, 0, open_b + 1);
            cur = after_b;
            continue;
        }
        let after_paren: String = byte_slice(after_b, close_b + 2, bytes_len(after_b));
        let close_p: Int = str_index_of(after_paren, ")");
        if close_p < 0 {
            out = out + byte_slice(cur, 0, open_b + 1);
            cur = after_b;
            continue;
        }
        let label: String = byte_slice(after_b, 0, close_b);
        let target: String = byte_slice(after_paren, 0, close_p);
        let href: String = resolve_link_href(target);
        out = out + byte_slice(cur, 0, open_b) + "<a href=\"" + href + "\">" + label + "</a>";
        let aplen: Int = bytes_len(after_paren);
        cur = byte_slice(after_paren, close_p + 1, aplen);
    }
    return out;
}

fn replace_delimiters(s: String, delim: String, open_tag: String, close_tag: String) -> String {
    let dlen: Int = bytes_len(delim);
    let mut out: String = "";
    let mut cur: String = s;
    while true {
        let first_idx: Int = str_index_of(cur, delim);
        if first_idx < 0 {
            out = out + cur;
            break;
        }
        let clen: Int = bytes_len(cur);
        let after_first: String = byte_slice(cur, first_idx + dlen, clen);
        let second_idx: Int = str_index_of(after_first, delim);
        if second_idx < 0 {
            out = out + cur;
            break;
        }
        let inner: String = byte_slice(after_first, 0, second_idx);
        out = out + byte_slice(cur, 0, first_idx) + open_tag + inner + close_tag;
        let aflen: Int = bytes_len(after_first);
        cur = byte_slice(after_first, second_idx + dlen, aflen);
    }
    return out;
}

pub fn inline_format(text: String) -> String {
    let mut code_spans: List[String] = list_new();
    let mut masked: String = "";
    let mut cur: String = text;
    while true {
        let first_idx: Int = str_index_of(cur, "`");
        if first_idx < 0 {
            masked = masked + cur;
            break;
        }
        let clen: Int = bytes_len(cur);
        let after_first: String = byte_slice(cur, first_idx + 1, clen);
        let second_idx: Int = str_index_of(after_first, "`");
        if second_idx < 0 {
            masked = masked + cur;
            break;
        }
        let code_content: String = byte_slice(after_first, 0, second_idx);
        let idx: Int = list_len(code_spans);
        code_spans = list_push(code_spans, code_content);
        masked = masked + byte_slice(cur, 0, first_idx) + "@@CODESPAN" + idx.to_string() + "@@";
        let aflen: Int = bytes_len(after_first);
        cur = byte_slice(after_first, second_idx + 1, aflen);
    }

    let mut escaped: String = escape_inline_html(masked);
    escaped = replace_links(escaped);
    escaped = replace_delimiters(escaped, "**", "<strong>", "</strong>");
    escaped = replace_delimiters(escaped, "__", "<strong>", "</strong>");
    escaped = replace_delimiters(escaped, "*", "<em>", "</em>");
    escaped = replace_delimiters(escaped, "_", "<em>", "</em>");

    let num_spans: Int = list_len(code_spans);
    let mut k: Int = 0;
    while k < num_spans {
        let ph: String = "@@CODESPAN" + k.to_string() + "@@";
        let raw_c: String = list_get(code_spans, k);
        let tag_c: String = "<code>" + escape_inline_html(raw_c) + "</code>";
        escaped = inline_str_replace(escaped, ph, tag_c);
        k = k + 1;
    }
    return escaped;
}
