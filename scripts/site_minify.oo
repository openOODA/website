// # SSG Safe HTML Minifier
//
// Logline: Safe whitespace compressor and comment stripper preserving <pre> and JSON-LD blocks.
//
// Setup: Pure string transformation module. Imported by site_build.oo.
//
// Beats:
//   1. Protect <pre>...</pre> blocks into indexed placeholders.
//   2. Protect <script type="application/ld+json">...</script> blocks into placeholders.
//   3. Strip <!-- ... --> HTML comments.
//   4. Collapse inter-tag whitespace and redundant blank lines.
//   5. Restore all protected blocks byte-for-byte.

import "std/core/str.oo";
import "site_markdown.oo";

pub fn ssg_str_replace(s: String, old: String, new_s: String) -> String {
    let old_len: Int = bytes_len(old);
    if old_len == 0 {
        return s;
    }
    let mut out: String = "";
    let mut current: String = s;
    while true {
        let idx: Int = str_index_of(current, old);
        if idx < 0 {
            out = out + current;
            break;
        }
        out = out + byte_slice(current, 0, idx) + new_s;
        let cur_len: Int = bytes_len(current);
        current = byte_slice(current, idx + old_len, cur_len);
    }
    return out;
}

fn strip_html_comments(s: String) -> String {
    let mut out: String = "";
    let mut cur: String = s;
    while true {
        let c_idx: Int = str_index_of(cur, "<!--");
        if c_idx < 0 {
            out = out + cur;
            break;
        }
        let clen: Int = bytes_len(cur);
        let after_c: String = byte_slice(cur, c_idx, clen);
        let close_c: Int = str_index_of(after_c, "-->");
        if close_c < 0 {
            out = out + cur;
            break;
        }
        out = out + byte_slice(cur, 0, c_idx);
        let aclen: Int = bytes_len(after_c);
        cur = byte_slice(after_c, close_c + 3, aclen);
    }
    return out;
}

pub fn minify_html(html_str: String) -> String {
    // 1. Protect <pre> blocks
    let mut pre_blocks: List[String] = list_new();
    let mut s: String = "";
    let mut cur1: String = html_str;
    while true {
        let p_idx: Int = str_index_of(cur1, "<pre");
        if p_idx < 0 {
            s = s + cur1;
            break;
        }
        let clen1: Int = bytes_len(cur1);
        let after_pre: String = byte_slice(cur1, p_idx, clen1);
        let close_p: Int = str_index_of(after_pre, "</pre>");
        if close_p < 0 {
            s = s + cur1;
            break;
        }
        let full_close: Int = close_p + 6;
        let pre_content: String = byte_slice(after_pre, 0, full_close);
        let idx: Int = list_len(pre_blocks);
        pre_blocks = list_push(pre_blocks, pre_content);
        s = s + byte_slice(cur1, 0, p_idx) + "@@PREBLOCK" + idx.to_string() + "@@";
        let aplen: Int = bytes_len(after_pre);
        cur1 = byte_slice(after_pre, full_close, aplen);
    }

    // 2. Protect <script type="application/ld+json"> blocks
    let mut ld_blocks: List[String] = list_new();
    let mut s2: String = "";
    let mut cur2: String = s;
    let script_needle: String = "<script type=\"application/ld+json\">";
    while true {
        let ld_idx: Int = str_index_of(cur2, script_needle);
        if ld_idx < 0 {
            s2 = s2 + cur2;
            break;
        }
        let clen2: Int = bytes_len(cur2);
        let after_ld: String = byte_slice(cur2, ld_idx, clen2);
        let close_ld: Int = str_index_of(after_ld, "</script>");
        if close_ld < 0 {
            s2 = s2 + cur2;
            break;
        }
        let full_close2: Int = close_ld + 9;
        let ld_content: String = byte_slice(after_ld, 0, full_close2);
        let idx: Int = list_len(ld_blocks);
        ld_blocks = list_push(ld_blocks, ld_content);
        s2 = s2 + byte_slice(cur2, 0, ld_idx) + "@@LDBLOCK" + idx.to_string() + "@@";
        let adlen: Int = bytes_len(after_ld);
        cur2 = byte_slice(after_ld, full_close2, adlen);
    }

    // 3. Strip HTML comments
    s2 = strip_html_comments(s2);

    // 4. Collapse whitespace
    let lines: List[String] = split_lines(s2);
    let num_l: Int = list_len(lines);
    let mut out: String = "";
    let mut k: Int = 0;
    while k < num_l {
        let stripped: String = trim_str(list_get(lines, k));
        if str_len(stripped) > 0 {
            if str_len(out) > 0 {
                if str_ends_with(out, ">") && str_starts_with(stripped, "<") {
                    out = out + stripped;
                } else {
                    out = out + "\n" + stripped;
                }
            } else {
                out = stripped;
            }
        }
        k = k + 1;
    }

    // 5. Restore JSON-LD blocks
    let num_ld: Int = list_len(ld_blocks);
    let mut li: Int = 0;
    while li < num_ld {
        let ph: String = "@@LDBLOCK" + li.to_string() + "@@";
        out = ssg_str_replace(out, ph, list_get(ld_blocks, li));
        li = li + 1;
    }

    // 6. Restore <pre> blocks
    let num_pre: Int = list_len(pre_blocks);
    let mut pi: Int = 0;
    while pi < num_pre {
        let ph: String = "@@PREBLOCK" + pi.to_string() + "@@";
        out = ssg_str_replace(out, ph, list_get(pre_blocks, pi));
        pi = pi + 1;
    }

    return out;
}
