// # SSG Markdown Block Parser
//
// Logline: Block markdown parser compiling .oot specifications to semantic HTML markup.
//
// Setup: Pure string compilation module. Imported by site_build.oo.
//
// Beats:
//   1. Split document into lines and detect block constructs.
//   2. Parse code fences with language tag and token syntax highlighting.
//   3. Parse markdown tables with headers, delimiters, and body rows.
//   4. Parse headings (#..######), blockquotes (>), lists (ul/ol), horizontal rules (---), and paragraphs.

import "std/core/str.oo";
import "site_highlight.oo";
import "site_inline.oo";

pub fn trim_str(s: String) -> String {
    return str_trim(s);
}

pub fn split_lines(s: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let mut cur: String = s;
    while true {
        let nl_idx: Int = str_index_of(cur, "\n");
        if nl_idx < 0 {
            if bytes_len(cur) > 0 {
                lines = list_push(lines, cur);
            }
            break;
        }
        let mut line: String = byte_slice(cur, 0, nl_idx);
        if str_ends_with(line, "\r") {
            let llen: Int = bytes_len(line);
            line = byte_slice(line, 0, llen - 1);
        }
        lines = list_push(lines, line);
        let clen: Int = bytes_len(cur);
        cur = byte_slice(cur, nl_idx + 1, clen);
    }
    return lines;
}

fn is_hr_line(s: String) -> Bool {
    let n: Int = str_len(s);
    if n < 3 { return false; }
    let c0: String = char_at(s, 0);
    if c0 != "-" && c0 != "*" && c0 != "_" { return false; }
    let mut i: Int = 1;
    while i < n {
        if char_at(s, i) != c0 { return false; }
        i = i + 1;
    }
    return true;
}

fn heading_level(s: String) -> Int {
    let n: Int = str_len(s);
    let mut i: Int = 0;
    while i < n && char_at(s, i) == "#" {
        i = i + 1;
    }
    if i >= 1 && i <= 6 && i < n && char_at(s, i) == " " {
        return i;
    }
    return 0;
}

fn is_ol_line(s: String) -> Bool {
    let n: Int = str_len(s);
    let mut i: Int = 0;
    while i < n && is_digit_c(char_at(s, i)) {
        i = i + 1;
    }
    return i > 0 && i + 1 < n && char_at(s, i) == "." && char_at(s, i + 1) == " ";
}

fn ol_text(s: String) -> String {
    let n: Int = str_len(s);
    let mut i: Int = 0;
    while i < n && is_digit_c(char_at(s, i)) {
        i = i + 1;
    }
    return trim_str(str_slice(s, i + 1, n));
}

fn split_cells(row: String) -> List[String] {
    let mut cells: List[String] = list_new();
    let n: Int = str_len(row);
    let mut i: Int = 0;
    if n > 0 && char_at(row, 0) == "|" { i = 1; }
    let mut chunk_start: Int = i;
    while i < n {
        let c: String = char_at(row, i);
        if c == "|" {
            let cell_text: String = trim_str(byte_slice(row, chunk_start, i));
            cells = list_push(cells, cell_text);
            chunk_start = i + 1;
        }
        i = i + 1;
    }
    if chunk_start < n {
        let cell_text: String = trim_str(byte_slice(row, chunk_start, n));
        if str_len(cell_text) > 0 {
            cells = list_push(cells, cell_text);
        }
    }
    return cells;
}

pub fn compile_markdown_to_html(md: String) -> String {
    let lines: List[String] = split_lines(md);
    let num_lines: Int = list_len(lines);
    let mut out: String = "";
    let mut i: Int = 0;
    let mut in_list: String = "";

    while i < num_lines {
        let line: String = list_get(lines, i);
        let stripped: String = trim_str(line);
        if str_len(stripped) == 0 {
            if in_list != "" {
                out = out + "</" + in_list + ">\n";
                in_list = "";
            }
            i = i + 1;
            continue;
        }
        if str_starts_with(stripped, "```") {
            if in_list != "" { out = out + "</" + in_list + ">\n"; in_list = ""; }
            let lang: String = trim_str(byte_slice(stripped, 3, str_len(stripped)));
            let mut code_body: String = "";
            i = i + 1;
            while i < num_lines {
                let code_line: String = list_get(lines, i);
                let code_stripped: String = trim_str(code_line);
                if str_starts_with(code_stripped, "```") {
                    i = i + 1;
                    break;
                }
                if str_len(code_body) > 0 { code_body = code_body + "\n"; }
                code_body = code_body + code_line;
                i = i + 1;
            }
            let h: String = highlight_code(code_body, lang);
            let class_attr: String = if str_len(lang) > 0 { " class=\"language-" + lang + "\"" } else { "" };
            out = out + "<pre><code" + class_attr + ">" + h + "</code></pre>\n";
            continue;
        }
        if str_starts_with(stripped, "|") && str_ends_with(stripped, "|") && i + 1 < num_lines {
            let next_s: String = trim_str(list_get(lines, i + 1));
            if str_contains(next_s, "|---") || str_contains(next_s, "|:---") || str_contains(next_s, "| ---") {
                if in_list != "" { out = out + "</" + in_list + ">\n"; in_list = ""; }
                let headers: List[String] = split_cells(stripped);
                i = i + 2;
                let mut table_s: String = "<table><thead><tr>";
                let num_h: Int = list_len(headers);
                let mut hi: Int = 0;
                while hi < num_h {
                    table_s = table_s + "<th>" + inline_format(list_get(headers, hi)) + "</th>";
                    hi = hi + 1;
                }
                table_s = table_s + "</tr></thead><tbody>";
                while i < num_lines {
                    let r_s: String = trim_str(list_get(lines, i));
                    if !str_starts_with(r_s, "|") || !str_ends_with(r_s, "|") { break; }
                    let cells: List[String] = split_cells(r_s);
                    table_s = table_s + "<tr>";
                    let num_c: Int = list_len(cells);
                    let mut ci: Int = 0;
                    while ci < num_c {
                        table_s = table_s + "<td>" + inline_format(list_get(cells, ci)) + "</td>";
                        ci = ci + 1;
                    }
                    table_s = table_s + "</tr>";
                    i = i + 1;
                }
                table_s = table_s + "</tbody></table>\n";
                out = out + table_s;
                continue;
            }
        }
        if is_hr_line(stripped) {
            if in_list != "" { out = out + "</" + in_list + ">\n"; in_list = ""; }
            out = out + "<hr>\n";
            i = i + 1;
            continue;
        }
        let h_lvl: Int = heading_level(stripped);
        if h_lvl > 0 {
            if in_list != "" { out = out + "</" + in_list + ">\n"; in_list = ""; }
            let h_text: String = trim_str(byte_slice(stripped, h_lvl, str_len(stripped)));
            let lvl_s: String = h_lvl.to_string();
            out = out + "<h" + lvl_s + ">" + inline_format(h_text) + "</h" + lvl_s + ">\n";
            i = i + 1;
            continue;
        }
        if str_starts_with(stripped, ">") {
            if in_list != "" { out = out + "</" + in_list + ">\n"; in_list = ""; }
            let mut q_body: String = "";
            while i < num_lines {
                let q_line: String = trim_str(list_get(lines, i));
                if !str_starts_with(q_line, ">") { break; }
                let inner_q: String = trim_str(byte_slice(q_line, 1, str_len(q_line)));
                if str_len(q_body) > 0 { q_body = q_body + " "; }
                q_body = q_body + inner_q;
                i = i + 1;
            }
            out = out + "<blockquote><p>" + inline_format(q_body) + "</p></blockquote>\n";
            continue;
        }
        if str_starts_with(stripped, "- ") || str_starts_with(stripped, "* ") {
            if in_list != "ul" {
                if in_list != "" { out = out + "</" + in_list + ">\n"; }
                out = out + "<ul>\n";
                in_list = "ul";
            }
            let item_s: String = trim_str(byte_slice(stripped, 2, str_len(stripped)));
            out = out + "<li>" + inline_format(item_s) + "</li>\n";
            i = i + 1;
            continue;
        }
        if is_ol_line(stripped) {
            if in_list != "ol" {
                if in_list != "" { out = out + "</" + in_list + ">\n"; }
                out = out + "<ol>\n";
                in_list = "ol";
            }
            out = out + "<li>" + inline_format(ol_text(stripped)) + "</li>\n";
            i = i + 1;
            continue;
        }
        if in_list != "" { out = out + "</" + in_list + ">\n"; in_list = ""; }
        let mut p_body: String = stripped;
        i = i + 1;
        while i < num_lines {
            let next_p: String = trim_str(list_get(lines, i));
            if str_len(next_p) == 0 || str_starts_with(next_p, "```") || heading_level(next_p) > 0 || str_starts_with(next_p, ">") || str_starts_with(next_p, "- ") || str_starts_with(next_p, "* ") || is_ol_line(next_p) || is_hr_line(next_p) {
                break;
            }
            if str_starts_with(next_p, "|") && str_ends_with(next_p, "|") { break; }
            p_body = p_body + " " + next_p;
            i = i + 1;
        }
        out = out + "<p>" + inline_format(p_body) + "</p>\n";
    }
    if in_list != "" { out = out + "</" + in_list + ">\n"; }
    return out;
}
