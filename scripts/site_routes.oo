// # SSG Route Catalog and Schema Metadata
//
// Logline: Route catalog, document-to-route lookup, and Schema.org JSON-LD generation for all 16 routes.
//
// Setup: Pure metadata module. Imported by site_build.oo.
//
// Beats:
//   1. Define RouteConfig struct for route metadata and target paths.
//   2. Provide doc_to_route lookup table for markdown cross-link resolution.
//   3. Provide get_routes_config() with complete metadata for all 16 routes.
//   4. Emit compact Schema.org JSON-LD structured data per route.

pub type RouteConfig = struct {
    route_id: Int,
    route_name: String,
    out_file: String,
    has_alias: Bool,
    alias_file: String,
    canonical: String,
    title: String,
    description: String,
    og_title: String,
    schema_type: String,
    source_type: String,
    source_file: String
};

pub fn doc_to_route(doc: String) -> String {
    if doc == "Home.oot" { return "overview"; }
    if doc == "Use.oot" { return "start"; }
    if doc == "Language.oot" { return "syntax"; }
    if doc == "Std.oot" { return "stdlib"; }
    if doc == "Options.oot" { return "cli"; }
    if doc == "Packages.oot" { return "packages"; }
    if doc == "Safety.oot" { return "security"; }
    if doc == "Morpher.oot" { return "defense"; }
    if doc == "Limits.oot" { return "internals"; }
    if doc == "Pay.oot" { return "pay"; }
    if doc == "QA.oot" { return "qa"; }
    if doc == "QuickRef.oot" { return "quickref"; }
    if doc == "Manifesto.oot" { return "manifesto"; }
    return "";
}

pub fn make_route(
    id: Int,
    name: String,
    out: String,
    has_a: Bool,
    alias: String,
    canon: String,
    title: String,
    desc: String,
    schema_t: String,
    src_t: String,
    src_f: String
) -> RouteConfig {
    return RouteConfig {
        route_id: id,
        route_name: name,
        out_file: out,
        has_alias: has_a,
        alias_file: alias,
        canonical: canon,
        title: title,
        description: desc,
        og_title: title,
        schema_type: schema_t,
        source_type: src_t,
        source_file: src_f
    };
}

pub fn get_routes_count() -> Int {
    return 16;
}

pub fn get_route_by_idx(idx: Int) -> RouteConfig {
    if idx == 0 { return make_route(16, "registry", "registry.html", true, "registry/index.html", "https://openooda.org/#registry", "openOODA — Sovereign Package Registry", "Search and install verified capability-sandboxed modules from the openOODA package store.", "WebApplication", "registry_html", ""); }
    if idx == 1 { return make_route(1, "home", "index.html", false, "", "https://openooda.org/", "openOODA", "openOODA is an AI-native, capability-secure systems programming language built for sovereign software synthesis.", "SoftwareApplication", "home_html", ""); }
    if idx == 2 { return make_route(2, "manifesto", "manifesto.html", true, "manifesto/index.html", "https://openooda.org/#manifesto", "openOODA — Sovereign Manifesto", "The openOODA Sovereign Manifesto: Zero ambient authority, hard modular constraints, active binary defenses, and zero-trust verification.", "TechArticle", "oot", "guide/Manifesto.oot"); }
    if idx == 3 { return make_route(3, "play", "play.html", true, "play/index.html", "https://openooda.org/#play", "openOODA — Interactive Playground", "Interactive in-browser WebAssembly compiler and execution playground for openOODA.", "WebApplication", "play_html", ""); }
    if idx == 4 { return make_route(4, "wasm", "wasm/index.html", false, "", "https://openooda.org/#wasm", "openOODA — WebAssembly Engine Preview", "openOODA Sovereign WebAssembly Engine Preview: 22 KB standalone binary, 0ms SPA routing, 9-palette theme engine, and sandboxed execution.", "SoftwareApplication", "wasm_html", ""); }
    if idx == 5 { return make_route(5, "start", "guide/index.html", false, "", "https://openooda.org/guide/#start", "openOODA Guide — Getting Started", "Step-by-step guide to installing openOODA, authoring programs, running tests, and compiling native binaries.", "TechArticle", "oot", "guide/Use.oot"); }
    if idx == 6 { return make_route(6, "syntax", "guide/Language.html", false, "", "https://openooda.org/guide/#syntax", "openOODA Guide — Language Syntax Reference", "openOODA language syntax reference: types, structs, sum types, pattern matching, capability annotations, and invariants.", "TechArticle", "oot", "guide/Language.oot"); }
    if idx == 7 { return make_route(7, "stdlib", "guide/Std.html", false, "", "https://openooda.org/guide/#stdlib", "openOODA Guide — Standard Library Reference", "Modular standard library reference: core, fs, net, crypto (ML-DSA, Kyber, ChaCha20), math, and sync.", "TechArticle", "oot", "guide/Std.oot"); }
    if idx == 8 { return make_route(8, "cli", "guide/Options.html", false, "", "https://openooda.org/guide/#cli", "openOODA Guide — Compiler CLI & Options", "openOODA compiler CLI reference: oodac compiler options and ooda workflow driver commands.", "TechArticle", "oot", "guide/Options.oot"); }
    if idx == 9 { return make_route(9, "packages", "guide/Packages.html", false, "", "https://openooda.org/guide/#packages", "openOODA Guide — Package Manager", "openOODA package manager and sovereign registry: CAS integrity hashes, capability declarations, and zero ambient supply chain security.", "TechArticle", "oot", "guide/Packages.oot"); }
    if idx == 10 { return make_route(10, "security", "guide/Safety.html", false, "", "https://openooda.org/guide/#security", "openOODA Guide — Capability Security", "Zero ambient authority security model: 14 unforgeable capability tokens, monotonic subsumption, and compile-time sandboxing.", "TechArticle", "oot", "guide/Safety.oot"); }
    if idx == 11 { return make_route(11, "defense", "guide/Morpher.html", false, "", "https://openooda.org/guide/#defense", "openOODA Guide — Active Binary Defense", "Active binary defenses: Moving Target Defense (MTD), Control Flow Flattening, XOR string encryption, and anti-ROP gadget destruction.", "TechArticle", "oot", "guide/Morpher.oot"); }
    if idx == 12 { return make_route(12, "internals", "guide/Limits.html", false, "", "https://openooda.org/guide/#internals", "openOODA Guide — Compiler Limits & Memory", "Compiler architecture and memory layout: 4-tier linear memory, SSA optimization pipeline, and 256-line modularity invariant.", "TechArticle", "oot", "guide/Limits.oot"); }
    if idx == 13 { return make_route(13, "pay", "guide/Pay.html", false, "", "https://openooda.org/guide/#pay", "openOODA Guide — Programmatic Economics", "Programmatic economics and x402 capability pricing for autonomous AI swarms and sovereign API micro-settlements.", "TechArticle", "oot", "guide/Pay.oot"); }
    if idx == 14 { return make_route(14, "qa", "guide/QA.html", false, "", "https://openooda.org/guide/#qa", "openOODA Guide — Zero-Trust Verification", "Zero-trust verification matrix: mathematical proofs and invariant testing on live compiled binaries.", "TechArticle", "oot", "guide/QA.oot"); }
    return make_route(15, "quickref", "guide/QuickRef.html", false, "", "https://openooda.org/guide/#quickref", "openOODA Guide — Quick Reference Cheat Sheet", "Comprehensive cheat sheet for openOODA syntax, standard library modules, capability tokens, and CLI flags.", "TechArticle", "oot", "guide/QuickRef.oot");
}

pub fn route_id(cfg: RouteConfig) -> Int { return cfg.route_id; }
pub fn route_name(cfg: RouteConfig) -> String { return cfg.route_name; }
pub fn route_out_file(cfg: RouteConfig) -> String { return cfg.out_file; }
pub fn route_has_alias(cfg: RouteConfig) -> Bool { return cfg.has_alias; }
pub fn route_alias_file(cfg: RouteConfig) -> String { return cfg.alias_file; }
pub fn route_canonical(cfg: RouteConfig) -> String { return cfg.canonical; }
pub fn route_title(cfg: RouteConfig) -> String { return cfg.title; }
pub fn route_description(cfg: RouteConfig) -> String { return cfg.description; }
pub fn route_og_title(cfg: RouteConfig) -> String { return cfg.og_title; }
pub fn route_schema_type(cfg: RouteConfig) -> String { return cfg.schema_type; }
pub fn route_source_type(cfg: RouteConfig) -> String { return cfg.source_type; }
pub fn route_source_file(cfg: RouteConfig) -> String { return cfg.source_file; }

pub fn generate_json_ld(cfg: RouteConfig) -> String {
    let st: String = route_schema_type(cfg);
    let desc: String = route_description(cfg);
    let canon: String = route_canonical(cfg);
    let ttl: String = route_title(cfg);
    if st == "SoftwareApplication" {
        return "{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"openOODA\",\"operatingSystem\":\"Linux, WebAssembly\",\"applicationCategory\":\"DeveloperApplication\",\"description\":\""
            + desc + "\",\"url\":\"" + canon + "\",\"downloadUrl\":\"https://openooda.org/install.sh\",\"softwareVersion\":\"v2.11.0\"}";
    }
    if st == "WebApplication" {
        return "{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"openOODA Playground\",\"applicationCategory\":\"DeveloperApplication\",\"operatingSystem\":\"Web Browser, WebAssembly\",\"description\":\""
            + desc + "\",\"url\":\"" + canon + "\"}";
    }
    return "{\"@context\":\"https://schema.org\",\"@type\":\"TechArticle\",\"headline\":\""
        + ttl + "\",\"description\":\"" + desc + "\",\"url\":\"" + canon
        + "\",\"inLanguage\":\"en\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"openOODA\",\"url\":\"https://openooda.org\"}}";
}
