// # openOODA Website — Anchor for Agents
//
// Logline: Public site at openooda.org. Shell in HTML. Repo docs
//          in pulled/*.oot fill #content. Dogfight is split JS.
//
// Setup: GitHub Pages, no build. New docs are .oo/.oot.
//        Browser residual is .js under src/, each <= 256 lines.
//
// Beats:
//   1. index.html — shell, nav, static home body, script list.
//   2. 404.html — static not-found. data-page=404 skips router.
//   3. pulled/*.oot — one page per product repo. Nav order:
//      openOODA, oodar, oodac, std, ooda, packaging, opm,
//      catalog, lsp, mcp. website and .github are not routes.
//   4. src/ — theme, route, dogfight, sky. See src/ANCHOR.oo.
//   5. styles/main.css — system monospace. No Google Fonts.
//   6. llms.txt — public LLM manual.
//   7. audit/ — 2026-09-04 zero-trust audit.

import "audit/ANCHOR.oo";
import "src/ANCHOR.oo";
import "pulled/ANCHOR.oo";
