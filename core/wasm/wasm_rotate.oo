// # Website Headline Rotator & Wordmark Bitmap Wasm32 Engine
//
// Logline: Owns hero headline strings and renders the 86x14 dot-matrix wordmark RGBA buffer in .oo.
// Setup: Encodes the 86x14 bitmap as 43-bit hi/lo integer rows for zero-allocation O(1) pixel reads.
// Beats:
//   1. Serve the 8 canonical openOODA headlines and guaranteed-nonrepeating next selector.
//   2. Decode any wordmark row and column directly from packed integer bitmasks.
//   3. Rasterize the wordmark into 4816 RGBA bytes inside linear-memory scratch for canvas upload.

fn ui_wm_hi(r: Int) -> Int {
    if r == 3 { return 1022722553980; }
    if r == 4 { return 2191499196670; }
    if r == 5 { return 3910329579975; }
    if r == 6 || r == 7 { return 3910564460999; }
    if r == 8 { return 3908450531783; }
    if r == 9 { return 3910329170375; }
    if r == 10 { return 3909485836542; }
    if r == 11 { return 3908940347516; }
    if r == 12 || r == 13 { return 14336; }
    return 0;
}

fn ui_wm_lo(r: Int) -> Int {
    if r == 0 { return 2131369640184; }
    if r == 1 { return 4365826908668; }
    if r == 2 { return 7820659159950; }
    if r == 3 || r == 4 { return 7820659159950; }
    if r == 5 || r == 6 { return 8782731834254; }
    if r == 7 || r == 8 || r == 9 { return 7820659159950; }
    if r == 10 { return 7818980614652; }
    if r == 11 { return 7817906340088; }
    return 0;
}

pub fn ui_wm_bit(r: Int, c: Int) -> Int {
    if r < 0 || r >= 14 || c < 0 || c >= 86 { return 0; }
    if c < 43 { return (ui_wm_hi(r) >> c) & 1; }
    return (ui_wm_lo(r) >> (c - 43)) & 1;
}

export fn oo_ui_headline_count() -> Int {
    return 8;
}

export fn oo_ui_headline_next(cur: Int, seed: Int) -> Int {
    let mut x: Int = seed ^ (cur * 2685821657736338717 + 1013904223);
    if x < 0 { x = 0 - x; }
    let step: Int = (x % 7) + 1;
    return (cur + step) & 7;
}

export fn oo_ui_headline_text(idx: Int) -> Int {
    oo_wasm_heap_reset();
    let k: Int = idx & 7;
    if k == 0 { return oo_wasm_scratch_write_str("Fail-Closed by Design"); }
    if k == 1 { return oo_wasm_scratch_write_str("Zero Ambient Authority"); }
    if k == 2 { return oo_wasm_scratch_write_str("Every Effect Needs a Capability"); }
    if k == 3 { return oo_wasm_scratch_write_str("Systems + Crypto + AI Unified"); }
    if k == 4 { return oo_wasm_scratch_write_str("Conservation of Authority"); }
    if k == 5 { return oo_wasm_scratch_write_str("Born With No Privileges"); }
    if k == 6 { return oo_wasm_scratch_write_str("5 Orgs, 65 Packages, 74 Repos"); }
    return oo_wasm_scratch_write_str("Verifiable Proof Over Trust");
}

export fn oo_ui_render_wordmark(ar: Int, ag: Int, ab: Int) -> Int {
    oo_wasm_heap_reset();
    let hr: Int = if ar + 60 > 255 { 255 } else { ar + 60 };
    let hg: Int = if ag + 60 > 255 { 255 } else { ag + 60 };
    let hb: Int = if ab + 60 > 255 { 255 } else { ab + 60 };
    let mut r: Int = 0;
    while r < 14 {
        let mut c: Int = 0;
        while c < 86 {
            let off: Int = (r * 86 + c) * 4;
            let on: Int = ui_wm_bit(r, c);
            if on == 1 {
                oo_wasm_scratch_write_u8(off, if c >= 39 { hr } else { ar });
                oo_wasm_scratch_write_u8(off + 1, if c >= 39 { hg } else { ag });
                oo_wasm_scratch_write_u8(off + 2, if c >= 39 { hb } else { ab });
                oo_wasm_scratch_write_u8(off + 3, 255);
            } else {
                oo_wasm_scratch_write_i32(off, 0);
            }
            c = c + 1;
        }
        r = r + 1;
    }
    return 4816;
}
