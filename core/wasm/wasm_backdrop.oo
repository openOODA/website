// # Website Backdrop Bayer Dither & Ripple Wasm32 Rasterizer
//
// Logline: Computes Bayer 8x8 dither, spotlights, wave modulation, ripples, and wordmark masks in .oo.
// Setup: Pure fixed-point milli-unit math (0..1000) reading frame params from scratch tail 65024..65171.
// Beats:
//   1. Unpack the 8x8 Bayer threshold matrix and Bhaskara integer sin/cos with zero libc calls.
//   2. Evaluate mouse/wandering spotlights and cubic-eased ripples per canvas cell.
//   3. Write 1-byte cell draw codes (0 bg, 1..3 wordmark, 16..79 mid/hot dither alpha) to scratch.

import "core/wasm/wasm_rotate.oo";

fn wb_bayer(r: Int, c: Int) -> Int {
    let rr: Int = r & 7;
    let mut row: Int = 96033277179903;
    if rr == 0 { row = 185441699530752; }
    else if rr == 1 { row = 118355111674928; }
    else if rr == 2 { row = 167587720743692; }
    else if rr == 3 { row = 100501132887868; }
    else if rr == 4 { row = 180973843822787; }
    else if rr == 5 { row = 113887255966963; }
    else if rr == 6 { row = 163119865035727; }
    return (row >> ((c & 7) * 6)) & 63;
}

fn wb_sin_milli(deg: Int) -> Int {
    let mut x: Int = deg & 255;
    let mut neg: Bool = false;
    if x >= 128 {
        x = x - 128;
        neg = true;
    }
    let p: Int = x * (128 - x);
    let den: Int = 20480 - p;
    let v: Int = if den > 0 { (4000 * p) / den } else { 0 };
    if neg { return 0 - v; }
    return v;
}

fn wb_cos_milli(deg: Int) -> Int {
    return wb_sin_milli(deg + 64);
}

fn wb_isqrt(n: Int) -> Int {
    if n <= 0 { return 0; }
    let mut x: Int = n;
    let mut y: Int = (x + 1) / 2;
    let mut k: Int = 0;
    while y < x && k < 24 {
        x = y;
        y = (x + n / x) / 2;
        k = k + 1;
    }
    return x;
}

fn wb_spot_m(px: Int, py: Int, tx: Int, ty: Int, rad: Int) -> Int {
    let mut dx: Int = px - tx;
    if dx < 0 { dx = 0 - dx; }
    if dx >= rad { return 0; }
    let mut dy: Int = py - ty;
    if dy < 0 { dy = 0 - dy; }
    if dy >= rad { return 0; }
    let d: Int = wb_isqrt(dx * dx + dy * dy);
    if d >= rad { return 0; }
    return ((rad - d) * 1000) / rad;
}

fn wb_rip_m(px: Int, py: Int) -> Int {
    let n: Int = oo_wasm_scratch_read_i32(65072);
    let mut best: Int = 0;
    let mut i: Int = 0;
    while i < n && i < 6 {
        let base: Int = 65076 + i * 16;
        let rx: Int = oo_wasm_scratch_read_i32(base);
        let ry: Int = oo_wasm_scratch_read_i32(base + 4);
        let age: Int = oo_wasm_scratch_read_i32(base + 8);
        let max_r: Int = oo_wasm_scratch_read_i32(base + 12);
        let inv: Int = 1000 - age;
        if inv > 0 {
            let rad: Int = (max_r * (1000 - (inv * inv * inv) / 1000000)) / 1000;
            let dx: Int = px - rx;
            let dy: Int = py - ry;
            let mut dist: Int = wb_isqrt(dx * dx + dy * dy) - rad;
            if dist < 0 { dist = 0 - dist; }
            if dist < 26 {
                let v: Int = (((26 - dist) * 1000) / 26 * inv) / 1000;
                if v > best { best = v; }
            }
        }
        i = i + 1;
    }
    return best;
}

fn wb_cell_code(c: Int, r: Int, sub_m: Int, t_ms: Int, cos_r: Int, wx: Int, wy: Int,
    is_word: Int) -> Int {
    let cpx: Int = oo_wasm_scratch_read_i32(65032);
    let px: Int = c * cpx;
    let py: Int = r * cpx;
    let mact: Int = oo_wasm_scratch_read_i32(65068);
    let sm: Int = if mact != 0 {
        wb_spot_m(px, py, oo_wasm_scratch_read_i32(65060), oo_wasm_scratch_read_i32(65064), 230)
    } else { 0 };
    let sw0: Int = wb_spot_m(px, py, wx, wy, 210);
    let sw: Int = (sw0 * (1000 - (sub_m * 650) / 1000)) / 1000;
    let spot_m: Int = if sm > (sw * 7) / 10 { sm } else { (sw * 7) / 10 };
    let rip_m: Int = wb_rip_m(px, py);
    if is_word == 1 {
        let raw_lit: Int = 550 + (spot_m * 135) / 100 + (rip_m * 150) / 100;
        let lit_m: Int = (raw_lit * (1000 - (sub_m * 9) / 10)) / 1000;
        if lit_m > 1250 { return 3; }
        if lit_m > 820 { return 2; }
        return 1;
    }
    let ang_c: Int = (c * 57) / 10 + (t_ms * 57041) / 1000000;
    let wave_m: Int = 500 + (wb_sin_milli(ang_c) * cos_r) / 2000;
    let w_term: Int = wave_m * (280 - (150 * sub_m) / 1000);
    let s_term: Int = spot_m * (680 - (350 * sub_m) / 1000);
    let val_m: Int = (w_term + s_term + rip_m * 950) / 1000;
    if val_m <= (wb_bayer(r, c) * 780) / 64 { return 0; }
    let a0: Int = 120 + (spot_m * 55) / 100 + (rip_m * 70) / 100;
    let mut a_m: Int = (a0 * (1000 - (450 * sub_m) / 1000)) / 1000;
    if a_m > 850 { a_m = 850; }
    let step: Int = (a_m * 31) / 850;
    if spot_m > 350 || rip_m > 300 { return 48 + step; }
    return 16 + step;
}

export fn oo_ui_render_backdrop() -> Int {
    oo_wasm_heap_reset();
    let cpx: Int = oo_wasm_scratch_read_i32(65032);
    let ox: Int = oo_wasm_scratch_read_i32(65036);
    let oy: Int = oo_wasm_scratch_read_i32(65040);
    let cols: Int = oo_wasm_scratch_read_i32(65044);
    let rows: Int = oo_wasm_scratch_read_i32(65048);
    let total: Int = cols * rows;
    if cpx <= 0 || total <= 0 || total > 65024 { return 0; }
    let sub_m: Int = oo_wasm_scratch_read_i32(65052);
    let t_ms: Int = oo_wasm_scratch_read_i32(65056);
    let w: Int = oo_wasm_scratch_read_i32(65024);
    let h: Int = oo_wasm_scratch_read_i32(65028);
    let wx: Int = (w * (500 + (340 * wb_sin_milli((t_ms * 30558) / 1000000)) / 1000)) / 1000;
    let wy: Int = (h * (450 + (220 * wb_cos_milli((t_ms * 44818) / 1000000)) / 1000)) / 1000;
    let mut r: Int = 0;
    while r < rows {
        let wm_r: Int = (r * cpx - oy) / cpx;
        let in_wm_r: Bool = sub_m < 850 && wm_r >= 0 && wm_r < 14;
        let cos_r: Int = wb_cos_milli((r * 57) / 10 - (t_ms * 44818) / 1000000);
        let mut c: Int = 0;
        while c < cols {
            let wm_c: Int = (c * cpx - ox) / cpx;
            let is_w: Int = if in_wm_r && ui_wm_bit(wm_r, wm_c) == 1 { 1 } else { 0 };
            let code: Int = wb_cell_code(c, r, sub_m, t_ms, cos_r, wx, wy, is_w);
            oo_wasm_scratch_write_u8(r * cols + c, code);
            c = c + 1;
        }
        r = r + 1;
    }
    return total;
}
