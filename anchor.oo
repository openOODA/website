// # openOODA Website — Anchor for Agents
//
// Logline: Public site at openooda.org. Static index.html is the home.
//
// Setup: GitHub Pages, no build. New docs are .oo/.oot.
//        No hash router. Do not load src/ as the homepage.
//
// Beats:
//   1. index.html — live home: install, panels, constellation (incl. ooda).
//   2. 404.html — static not-found. No router.
//   3. docs/anchor.oo — RFC-0005 package manual for this repo.
//   4. src/ — retired SPA; not the homepage path.
//   5. js/, styles/, llms.txt — copy/rotate/panels, chrome, LLM surface.

import "docs/anchor.oo";
import "js/anchor.oo";
import "src/anchor.oo";
