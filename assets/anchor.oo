// # assets/ — Static Binary Assets Anchor
//
// Logline: Browser-loadable binary files referenced from HTML shell.
//
// Setup: Sovereign asset anchor exporting paths to static resources.
//
// Beats:
//   1. Expose favicon path.
//   2. Expose open-graph social card path.
//   3. Retain asset identifiers for website compiler.

pub fn asset_favicon_path() -> String {
    return "assets/favicon.svg";
}

pub fn asset_open_graph_path() -> String {
    return "assets/open-graph.png";
}
